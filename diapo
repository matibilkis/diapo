class Estructura(HTMLParser):
    """Líneas del archivo donde empieza y termina cada slide, y dónde está cada elemento."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.en_deck = False
        self.pila: list[str] = []
        self.slides: list[dict] = []

    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        if not self.en_deck:
            if tag == 'div' and d.get('id') == 'deck':
                self.en_deck, self.pila = True, []
            return
        clases = (d.get('class') or '').split()
        linea = self.getpos()[0]
        if not self.pila and tag == 'section' and 'slide' in clases:
            self.slides.append({'ini': linea, 'fin': linea, 'titulo': d.get('data-titulo', ''), 'els': []})
        elif len(self.pila) == 1 and self.slides and 'el' in clases:
            self.slides[-1]['els'].append({'linea': linea, 'tag': tag, 'clases': ' '.join(c for c in clases if c != 'el')})
        if tag not in VACIOS:
            self.pila.append(tag)

    def handle_endtag(self, tag):
        if not self.en_deck or tag in VACIOS:
            return
        if not self.pila:
            self.en_deck = tag != 'div'
            return
        while self.pila and self.pila.pop() != tag:
            pass
        if not self.pila and tag == 'section' and self.slides:
            self.slides[-1]['fin'] = self.getpos()[0]


def contexto_chat(deck: Path, slide, elemento) -> str:
    """Lo que Claude necesita saber para entender «esto» o «esta slide»."""
    e = Estructura()
    e.feed(deck.read_text(encoding='utf-8', errors='replace'))
    partes = [f'{deck.name} tiene {len(e.slides)} slides.']
    if isinstance(slide, int) and 1 <= slide <= len(e.slides):
        s = e.slides[slide - 1]
        partes.append(f'Está mirando la slide {slide}, «{s["titulo"]}», líneas {s["ini"]} a {s["fin"]}.')
        if isinstance(elemento, int) and 0 <= elemento < len(s['els']):
            el = s['els'][elemento]
            partes.append(f'Tiene elegido el elemento de la línea {el["linea"]} (<{el["tag"]} class="{("el " + el["clases"]).strip()}">).')
        else:
            partes.append('No tiene ningún elemento elegido.')
    return '[Panel de diapo: ' + ' '.join(partes) + ']'


def reglas_chat(deck: Path) -> str:
    texto = deck.read_text(encoding='utf-8', errors='replace')
    W, H = medidas(texto)
    m = re.search(r'<style id="estilos">(.*?)</style>', texto, re.S)
    est = m.group(1) if m else ''
    m = re.search(r'<style id="tema">(.*?)</style>', texto, re.S)
    tem = m.group(1) if m else ''
    estilos = ', '.join(f'{n} (.{c})' for n, c in re.findall(r'/\*\s*estilo:\s*([^*]+?)\s*\*/\s*\.([\w-]+)', est)) or 'ninguno'
    fondos = ', '.join(f'{n} (.slide.{c})' for n, c in re.findall(r'/\*\s*fondo:\s*([^*]+?)\s*\*/\s*\.slide\.([\w-]+)', est)) or 'ninguno'
    colores = ', '.join(f'var(--{n}) {v}' for n, v in re.findall(r'--([\w-]+)\s*:\s*(#[0-9a-fA-F]{3,8})\s*;', tem)) or 'ninguno'
    return f"""Estás en el panel de chat de diapo, al costado de la presentación que la persona edita en el navegador. Trabajás sobre un solo archivo: {deck.name}, en la carpeta actual. Cada vez que lo guardás, la página se actualiza sola: {config().get('nombre') or 'la persona'} ve el cambio enseguida y lo puede deshacer con Ctrl+Z.

Cada mensaje empieza con un contexto entre corchetes: en qué slide está (número, título y líneas del archivo) y qué elemento tiene elegido. «Esto», «acá» o «esta slide» se refieren a eso.

Formato del archivo:
- <div id="deck" data-ancho="{W}" data-alto="{H}"> contiene un <section class="slide" data-titulo="…"> por slide, en orden; la primera es la slide 1.
- Lo movible es hijo directo de la slide, con la clase el y style="left:…px;top:…px;width:…px" sobre un lienzo de {W}×{H}. El orden en el archivo es el orden de apilado.
- Textos: <div class="el ESTILO">. Links: <a class="el fuente" href="…" target="_blank" rel="noopener">[sitio]</a>. Imágenes: <img class="el" src="img/…" alt="">. Recuadro para completar: <div class="el hueco" style="…;height:…px">qué va</div>.
- Notas del orador: <aside class="notas"> al final de cada slide.
- Estilos del tema: {estilos}. Fondos de slide: {fondos}. Colores: {colores}. Usá estas clases y variables en vez de tipografías o colores sueltos.
- No toques <style id="motor-css">, <script id="motor"> ni <style id="fuentes">.

Cómo trabajar:
- Leé con Read solo las líneas que necesitás (offset y limit) y editá con Edit, con cambios mínimos. No reescribas el archivo.
- Para una slide nueva, copiá la estructura de una parecida de la misma presentación.
- Si cambian tamaños, posiciones o textos largos, verificá con `diapo revisar {deck.name} --slides N` y mirá la captura .diapo/revision/slide-NN.png con Read. Para un cambio chico de texto no hace falta.
- Los pedidos que dejó con el botón Pedido se ven con `diapo pedidos {deck.name}`. Al resolver uno, borrá su atributo data-pedido.
- Podés leer otros archivos si te los nombra, pero solo podés modificar esta presentación. No podés bajar imágenes: si falta una, dejá un hueco que diga qué va.
- Contenido: seguí el tono del resto de la presentación, frases cortas, sin aforismos. Los datos van con su fuente, en las notas o en un [link].

Respondé en español, en una o dos líneas: qué cambiaste y en qué slide. Si algo no se pudo, decilo."""


def paso_chat(nombre: str, entrada: dict, deck: Path) -> str:
    """Lo que está haciendo Claude, en pocas palabras, para mostrar en el panel."""
    f = str(entrada.get('file_path') or entrada.get('path') or '')
    base = Path(f).name if f else ''
    if nombre == 'Read':
        m = re.search(r'slide-(\d+)\.png$', f)
        if m:
            return f'Mira la captura de la slide {int(m.group(1))}'
        if base == deck.name:
            off, lim = entrada.get('offset'), entrada.get('limit')
            return f'Lee las líneas {off} a {off + lim - 1}' if isinstance(off, int) and isinstance(lim, int) else 'Lee la presentación'
        return f'Lee {base}'
    if nombre in ('Edit', 'MultiEdit'):
        return 'Edita la presentación' if base == deck.name else f'Quiere editar {base}'
    if nombre == 'Write':
        return f'Quiere escribir {base}'
    if nombre == 'Bash':
        c = str(entrada.get('command') or '').strip()
        if c.startswith('diapo revisar'):
            m = re.search(r'--slides\s+(\S+)', c)
            return 'Revisa cómo quedó' + (f' la slide {m.group(1)}' if m else '')
        if c.startswith('diapo pedidos'):
            return 'Lee los pedidos'
        if re.match(r'(grep|rg|sed -n|head|tail|cat|wc|ls)\b', c):
            return 'Busca en el archivo'
        return f'Quiere correr: {c[:60]}'
    if nombre in ('Grep', 'Glob'):
        return 'Busca en el archivo'
    if nombre == 'WebSearch':
        return f'Busca en la web: {str(entrada.get("query", ""))[:60]}'
    if nombre == 'WebFetch':
        return f'Lee {urlparse(str(entrada.get("url", ""))).netloc or "una página"}'
    return nombre


class Chat:
    """Una conversación con Claude Code sin ventana para una presentación: un proceso que recibe los
    mensajes por stdin (stream-json). Solo puede editar ese archivo y correr diapo revisar/pedidos."""
    SIN_HEREDAR = ('CLAUDE_PID', 'CLAUDE_EFFORT', 'AI_AGENT', 'TMUX', 'TMUX_PANE')

    def __init__(self, deck: Path, modelo: str | None):
        self.deck, self.modelo = deck, modelo
        self.proc = None
        self.ocupado = False
        self.pendiente = None
        self.retoma = False
        self.vio_inicio = False
        self.t0 = 0.0
        self.error = ''
        self.modelo_real = None
        self.reglas = ''
        self.oyentes: list[queue.Queue] = []
        self.candado = threading.Lock()
        self.estado = carpeta_oculta(deck.parent) / 'chat.json'
        try:
            self.sesion = json.loads(self.estado.read_text(encoding='utf-8')).get(deck.name)
        except (OSError, ValueError):
            self.sesion = None
        self.archivo_historial = carpeta_oculta(deck.parent) / f'chat-{deck.stem}.json'
        try:
            self.historial = json.loads(self.archivo_historial.read_text(encoding='utf-8'))
        except (OSError, ValueError):
            self.historial = []

    def anotar(self, rol: str, texto: str, **extra) -> None:
        self.historial = (self.historial + [{'rol': rol, 'texto': texto, **extra}])[-300:]
        try:
            self.archivo_historial.write_text(json.dumps(self.historial, ensure_ascii=False), encoding='utf-8')
        except OSError:
            pass

    def guardar_sesion(self) -> None:
        try:
            d = json.loads(self.estado.read_text(encoding='utf-8'))
        except (OSError, ValueError):
            d = {}
        if self.sesion:
            d[self.deck.name] = self.sesion
        else:
            d.pop(self.deck.name, None)
        self.estado.write_text(json.dumps(d), encoding='utf-8')

    def emitir(self, ev: dict) -> None:
        t = ev.get('tipo')
        if t in ('paso', 'info', 'error'):
            self.anotar(t, ev['texto'])
        elif t == 'texto':
            self.anotar('claude', ev['texto'])
        elif t == 'fin':
            self.anotar('meta', f'{ev["segundos"]} s') if ev.get('ok') else self.anotar('error', ev.get('texto') or 'Claude no terminó bien.')
        elif t == 'parado':
            self.anotar('info', 'Lo paré. El próximo mensaje sigue la misma conversación.')
        elif t == 'nueva':
            self.historial = []
            self.archivo_historial.unlink(missing_ok=True)
        for q in list(self.oyentes):
            q.put(ev)

    def arrancar(self) -> None:
        self.reglas = reglas_chat(self.deck)
        cmd = ['claude', '-p', '--input-format', 'stream-json', '--output-format', 'stream-json', '--verbose',
               '--safe-mode', '--permission-mode', 'default',
               '--allowedTools', f'Edit(./{self.deck.name})', 'Bash(diapo revisar:*)', 'Bash(diapo pedidos:*)',
               '--append-system-prompt', self.reglas]
        if self.modelo:
            cmd += ['--model', self.modelo]
        self.retoma = bool(self.sesion)
        if self.sesion:
            cmd += ['--resume', self.sesion]
        env = {k: v for k, v in os.environ.items()
               if not (k == 'CLAUDECODE' or k.startswith(('CLAUDE_CODE_', 'ORCA_', 'AGENTDECK')) or k in self.SIN_HEREDAR)}
        self.vio_inicio, self.error = False, ''
        self.proc = subprocess.Popen(cmd, cwd=self.deck.parent, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.PIPE, text=True, encoding='utf-8', bufsize=1)
        threading.Thread(target=self.leer, args=(self.proc,), daemon=True).start()
        threading.Thread(target=self.leer_error, args=(self.proc,), daemon=True).start()

    def leer_error(self, proc) -> None:
        for line in proc.stderr:
            self.error = (self.error + line)[-800:]

    def leer(self, proc) -> None:
        for line in proc.stdout:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if proc is self.proc:
                self.procesar(ev)
        proc.wait()
        if proc is not self.proc or not self.ocupado:
            if proc is self.proc:
                self.proc = None
            return
        self.proc = None
        if self.retoma and not self.vio_inicio and self.pendiente:
            self.sesion = None
            self.guardar_sesion()
            self.emitir({'tipo': 'info', 'texto': 'No pude retomar la conversación anterior; empiezo una nueva.'})
            with self.candado:
                self.arrancar()
                self.escribir(self.pendiente)
            return
        self.ocupado, self.pendiente = False, None
        detalle = self.error.strip().splitlines()[-1] if self.error.strip() else ''
        self.emitir({'tipo': 'error', 'texto': 'Claude se cerró antes de terminar.' + (f' ({detalle[:200]})' if detalle else '')})

    def procesar(self, ev: dict) -> None:
        t, st = ev.get('type'), ev.get('subtype')
        if t == 'system' and st == 'init':
            self.vio_inicio = True
            sid = ev.get('session_id')
            if sid and sid != self.sesion:
                self.sesion = sid
                self.guardar_sesion()
            if ev.get('model') and ev['model'] != self.modelo_real:
                self.modelo_real = ev['model']
                self.emitir({'tipo': 'modelo', 'modelo': self.modelo_real})
        elif t == 'system' and st == 'permission_denied':
            self.emitir({'tipo': 'paso', 'texto': 'Quiso hacer algo sin permiso y lo frené'})
        elif t == 'assistant':
            for c in (ev.get('message') or {}).get('content') or []:
                if c.get('type') == 'text' and (c.get('text') or '').strip():
                    self.emitir({'tipo': 'texto', 'texto': c['text'].strip()})
                elif c.get('type') == 'tool_use':
                    self.emitir({'tipo': 'paso', 'texto': paso_chat(c.get('name', ''), c.get('input') or {}, self.deck)})
        elif t == 'result':
            self.ocupado, self.pendiente = False, None
            ok = st == 'success' and not ev.get('is_error')
            fin = {'tipo': 'fin', 'ok': ok, 'segundos': round(time.time() - self.t0, 1)}
            if not ok:
                fin['texto'] = str(ev.get('result') or st or 'error')[:300]
            self.emitir(fin)

    def escribir(self, texto: str) -> None:
        msg = {'type': 'user', 'message': {'role': 'user', 'content': [{'type': 'text', 'text': texto}]}}
        self.proc.stdin.write(json.dumps(msg, ensure_ascii=False) + '\n')
        self.proc.stdin.flush()

    def enviar(self, texto: str, slide, elemento, ctx: str = '') -> tuple[int, dict]:
        if not shutil.which('claude'):
            return 503, {'error': 'No encuentro el comando claude.'}
        with self.candado:
            if self.ocupado:
                return 409, {'error': 'Claude todavía está trabajando en el pedido anterior.'}
            respaldar(self.deck, cada=0)
            msg = contexto_chat(self.deck, slide, elemento) + '\n\n' + texto
            if self.proc is not None and self.reglas != reglas_chat(self.deck):
                viejo, self.proc = self.proc, None
                viejo.terminate()
            self.ocupado, self.pendiente, self.t0 = True, msg, time.time()
            self.anotar('yo', texto, ctx=str(ctx)[:200])
            for _ in range(2):
                if self.proc is None or self.proc.poll() is not None:
                    self.arrancar()
                try:
                    self.escribir(msg)
                    break
                except (BrokenPipeError, OSError):
                    self.proc = None
            else:
                self.ocupado, self.pendiente = False, None
                return 500, {'error': 'No pude hablar con Claude Code.'}
        print(f'  {datetime.now():%H:%M:%S} pedido a Claude: {texto[:70]}')
        self.emitir({'tipo': 'pensando'})
        return 202, {'ok': True}

    def parar(self, avisar: bool = True) -> None:
        with self.candado:
            p, self.proc = self.proc, None
            self.ocupado, self.pendiente = False, None
        if p and p.poll() is None:
            p.terminate()
            try:
                p.wait(3)
            except subprocess.TimeoutExpired:
                p.kill()
        if avisar:
            self.emitir({'tipo': 'parado'})

    def nueva(self) -> None:
        self.parar(avisar=False)
        self.sesion = None
        self.guardar_sesion()
        self.emitir({'tipo': 'nueva'})


