CHEQUEO_JS = r"""
({W, H, sel}) => {
  const out = [];
  const slides = [...document.querySelectorAll('#deck > section.slide')];
  const deckR = document.getElementById('deck').getBoundingClientRect();
  const k = deckR.width / W || 1;
  const rects = el => {
    const out = [], tw = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    let t;
    while ((t = tw.nextNode())) {
      if (!t.nodeValue.trim()) continue;
      const r = document.createRange(); r.selectNodeContents(t);
      for (const x of r.getClientRects()) if (x.width > 1 && x.height > 1) out.push({l: (x.left - deckR.left) / k, t: (x.top - deckR.top) / k, r: (x.right - deckR.left) / k, b: (x.bottom - deckR.top) / k});
    }
    return out;
  };
  const corto = el => ((el.innerText || el.textContent || '').trim() || el.getAttribute('src') || el.className).replace(/\s+/g, ' ').slice(0, 60);
  const cruce = (a, b) => Math.min(a.r, b.r) - Math.max(a.l, b.l) > 3 && Math.min(a.b, b.b) - Math.max(a.t, b.t) > 3;
  slides.forEach((s, i) => {
    const n = i + 1;
    if (sel && !sel.includes(n)) return;
    slides.forEach(o => o.classList.toggle('actual', o === s));
    const els = [...s.querySelectorAll(':scope > .el')];
    const textos = [];
    els.forEach(el => {
      const L = el.offsetLeft, T = el.offsetTop, w = el.offsetWidth, h = el.offsetHeight;
      const esTexto = el.tagName !== 'IMG' && !el.classList.contains('hueco') && (el.textContent || '').trim();
      if (esTexto) {
        const rs = rects(el);
        textos.push({el, rs});
        if (!el.classList.contains('sangrado') && rs.some(x => x.l < -2 || x.t < -2 || x.r > W + 2 || x.b > H + 2)) out.push({n, tipo: 'texto fuera del lienzo', txt: corto(el)});
        if (el.scrollWidth > el.clientWidth + 2 && getComputedStyle(el).whiteSpace !== 'nowrap') out.push({n, tipo: 'texto más ancho que su caja', txt: corto(el), det: `${el.scrollWidth} > ${el.clientWidth} px`});
        if (el.style.height && el.scrollHeight > el.clientHeight + 3) out.push({n, tipo: 'texto más alto que su caja', txt: corto(el), det: `${el.scrollHeight} > ${el.clientHeight} px`});
      } else if (!el.classList.contains('sangrado')) {
        const ix = Math.max(0, Math.min(L + w, W) - Math.max(L, 0)), iy = Math.max(0, Math.min(T + h, H) - Math.max(T, 0));
        const dentro = (ix * iy) / Math.max(w * h, 1);
        if (dentro < 0.75) out.push({n, tipo: 'sale del lienzo', txt: corto(el), det: `${Math.round((1 - dentro) * 100)}% afuera`});
      }
      if (el.tagName === 'IMG' && (!el.complete || el.naturalWidth === 0)) out.push({n, tipo: 'imagen que no carga', txt: el.getAttribute('src') || ''});
      if (el.classList.contains('hueco')) out.push({n, tipo: 'recuadro para completar', txt: corto(el)});
      if (el.dataset.pedido) out.push({n, tipo: 'pedido a Claude', txt: corto(el), det: el.dataset.pedido});
    });
    if (s.dataset.pedido) out.push({n, tipo: 'pedido a Claude', txt: '(toda la slide)', det: s.dataset.pedido});
    for (let a = 0; a < textos.length; a++) for (let b = a + 1; b < textos.length; b++) {
      if (textos[a].rs.some(ra => textos[b].rs.some(rb => cruce(ra, rb)))) out.push({n, tipo: 'textos que se pisan', txt: `${corto(textos[a].el).slice(0, 28)} / ${corto(textos[b].el).slice(0, 28)}`});
    }
  });
  const fuentes = [...document.fonts].filter(f => f.status === 'error').map(f => `${f.family} ${f.weight} ${f.style}`);
  return {problemas: out, fuentes, titulos: slides.map(s => s.dataset.titulo || '')};
}
"""


def rango(texto: str | None, total: int) -> list[int] | None:
    if not texto:
        return None
    out = set()
    for parte in texto.split(','):
        parte = parte.strip()
        if '-' in parte:
            a, b = parte.split('-', 1)
            out.update(range(int(a), int(b) + 1))
        elif parte:
            out.add(int(parte))
    return sorted(n for n in out if 1 <= n <= total)


def abrir_navegador(deck: Path, ancho: int, alto: int):
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        die('para revisar y exportar hace falta Playwright para Python (pip install playwright).')
    pw = sync_playwright().start()
    b = pw.chromium.launch()
    pg = b.new_page(viewport={'width': ancho, 'height': alto})
    errores = []
    pg.on('pageerror', lambda e: errores.append(str(e)))
    pg.goto(deck.as_uri())
    pg.wait_for_timeout(400)
    pg.evaluate('Promise.all([...document.fonts].map(f => f.load().catch(() => null)))')
    pg.evaluate('Promise.all([...document.images].map(i => i.decode ? i.decode().catch(() => null) : null))')
    pg.wait_for_timeout(200)
    return pw, b, pg, errores


def medidas(texto: str) -> tuple[int, int]:
    m = re.search(r'<div id="deck"[^>]*data-ancho="(\d+)"[^>]*data-alto="(\d+)"', texto)
    return (int(m.group(1)), int(m.group(2))) if m else (1280, 720)


def cmd_revisar(a) -> None:
    deck = resolver_deck(a.archivo)
    texto = deck.read_text(encoding='utf-8', errors='replace')
    W, H = medidas(texto)
    salida = Path(a.salida).expanduser().resolve() if a.salida else carpeta_oculta(deck.parent, 'revision')
    salida.mkdir(parents=True, exist_ok=True)
    pw, b, pg, errores = abrir_navegador(deck, W, H)
    try:
        total = pg.evaluate("document.querySelectorAll('#deck > section.slide').length")
        sel = rango(a.slides, total)
        res = pg.evaluate(CHEQUEO_JS, {'W': W, 'H': H, 'sel': sel})
        pg.add_style_tag(content='[data-ui]{display:none!important}')
        capturas = []
        if not a.sin_capturas:
            for f in salida.glob('slide-*.png'):
                f.unlink()
            for n in (sel or range(1, total + 1)):
                pg.evaluate(f'(window.diapo || window.deckAPI).go({n - 1})')
                pg.wait_for_timeout(60)
                f = salida / f'slide-{n:02d}.png'
                pg.screenshot(path=str(f))
                capturas.append((n, f))
    finally:
        b.close()
        pw.stop()
    hojas = hacer_hojas(capturas, res['titulos'], salida) if capturas else []
    if a.json:
        print(json.dumps({'archivo': str(deck), 'slides': total, 'problemas': res['problemas'], 'fuentes_con_error': res['fuentes'],
                          'errores_js': errores, 'capturas': [str(f) for _, f in capturas], 'hojas': [str(h) for h in hojas]}, ensure_ascii=False, indent=1))
        return
    print(f'{deck.name}: {total} slides, lienzo {W}×{H}')
    graves = [p for p in res['problemas'] if p['tipo'] not in ('recuadro para completar', 'pedido a Claude')]
    avisos = [p for p in res['problemas'] if p not in graves]
    for p in graves:
        print(f'  slide {p["n"]:>2} · {p["tipo"]}: {p["txt"]}' + (f' ({p["det"]})' if p.get('det') else ''))
    if not graves:
        print('  sin desbordes, superposiciones ni imágenes rotas')
    for p in avisos:
        print(f'  slide {p["n"]:>2} · {p["tipo"]}: {p["txt"]}' + (f' → {p["det"]}' if p.get('det') else ''))
    for f in res['fuentes']:
        print(f'  tipografía que no cargó: {f}')
    for e in errores:
        print(f'  error de JavaScript: {e}')
    if capturas:
        print(f'Capturas: {salida}/slide-NN.png')
        for h in hojas:
            print(f'Hoja de contactos: {h}')


def hacer_hojas(capturas, titulos, salida: Path, por_hoja: int = 12) -> list[Path]:
    from PIL import Image, ImageDraw, ImageFont
    for h in salida.glob('hoja-*.png'):
        h.unlink()
    try:
        font = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 15)
    except Exception:
        font = ImageFont.load_default()
    hojas = []
    for k in range(0, len(capturas), por_hoja):
        grupo = capturas[k:k + por_hoja]
        tw = 460
        ims = []
        for n, f in grupo:
            im = Image.open(f).convert('RGB')
            th = round(im.height * tw / im.width)
            ims.append((n, im.resize((tw, th))))
        th = max(im.height for _, im in ims)
        cols = 3
        filas = math.ceil(len(ims) / cols)
        hoja = Image.new('RGB', (cols * (tw + 12) + 12, filas * (th + 40) + 12), (60, 60, 66))
        d = ImageDraw.Draw(hoja)
        for j, (n, im) in enumerate(ims):
            x = 12 + (j % cols) * (tw + 12)
            y = 12 + (j // cols) * (th + 40)
            hoja.paste(im, (x, y))
            t = f'{n} · {titulos[n - 1] if n - 1 < len(titulos) else ""}'
            d.text((x, y + th + 8), t[:52], fill=(235, 235, 235), font=font)
        p = salida / f'hoja-{k // por_hoja + 1}.png'
        hoja.save(p)
        hojas.append(p)
    return hojas


def cmd_pdf(a) -> None:
    deck = resolver_deck(a.archivo)
    W, H = medidas(deck.read_text(encoding='utf-8', errors='replace'))
    out = Path(a.salida).expanduser().resolve() if a.salida else deck.with_suffix('.pdf')
    pw, b, pg, errores = abrir_navegador(deck, W, H)
    try:
        pg.pdf(path=str(out), prefer_css_page_size=True, print_background=True)
    finally:
        b.close()
        pw.stop()
    paginas = ''
    if shutil.which('pdfinfo'):
        m = re.search(r'Pages:\s+(\d+)', subprocess.run(['pdfinfo', str(out)], capture_output=True, text=True).stdout)
        paginas = f', {m.group(1)} páginas' if m else ''
    print(f'PDF: {out}{paginas}')


