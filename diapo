def esc(s: str) -> str:
    return htmllib.escape(str(s), quote=True)


def die(msg: str, code: int = 1) -> None:
    print(f'diapo: {msg}', file=sys.stderr)
    sys.exit(code)


def escribir(path: Path, texto: str) -> None:
    tmp = path.with_name(f'.{path.name}.tmp')
    tmp.write_text(texto, encoding='utf-8')
    os.replace(tmp, path)


def carpeta_oculta(carpeta: Path, sub: str = '') -> Path:
    base = carpeta / '.diapo'
    base.mkdir(exist_ok=True)
    gi = base / '.gitignore'
    if not gi.exists():
        gi.write_text('*\n', encoding='utf-8')
    if sub:
        (base / sub).mkdir(parents=True, exist_ok=True)
        return base / sub
    return base


def respaldar(archivo: Path, guardar: int = 50, cada: int = 60) -> None:
    if not archivo.exists():
        return
    dest = carpeta_oculta(archivo.parent, 'respaldos')
    ultimo = max(dest.glob(f'{archivo.stem}.*{archivo.suffix}'), key=lambda v: v.stat().st_mtime, default=None)
    if cada and ultimo and time.time() - ultimo.stat().st_mtime < cada:
        return
    stamp = datetime.now().strftime('%Y%m%d-%H%M%S')
    shutil.copy2(archivo, dest / f'{archivo.stem}.{stamp}{archivo.suffix}')
    viejos = sorted(dest.glob(f'{archivo.stem}.*{archivo.suffix}'))
    for v in viejos[:-guardar]:
        v.unlink(missing_ok=True)


def resolver_deck(ruta: str) -> Path:
    p = Path(ruta).expanduser()
    if p.is_dir():
        htmls = sorted(x for x in p.glob('*.html') if not x.name.startswith('.'))
        if len(htmls) != 1:
            die(f'en {p} hay {len(htmls)} archivos .html; indicá cuál.')
        p = htmls[0]
    if not p.exists():
        die(f'no existe {p}')
    return p.resolve()


def es_diapo(texto: str) -> bool:
    return 'id="motor-css"' in texto and 'id="motor"' in texto


