    return ps.filter(p => p.runs.some(r => !r.br));
  };
  const deckR = deck.getBoundingClientRect(), k = deckR.width / (parseInt(deck.dataset.ancho, 10) || 1280);
  const rectDe = el => {
    let r = el.getBoundingClientRect(), L = r.left, T = r.top, R = r.right, B = r.bottom;
    el.querySelectorAll('*').forEach(d => { const q = d.getBoundingClientRect(); if (q.width && q.height) { L = Math.min(L, q.left); T = Math.min(T, q.top); R = Math.max(R, q.right); B = Math.max(B, q.bottom); } });
    return {x: (L - deckR.left) / k, y: (T - deckR.top) / k, w: (R - L) / k, h: (B - T) / k};
  };
  const items = [];
  [...s.querySelectorAll(':scope > .el')].forEach((el, i) => {
    const cs = getComputedStyle(el);
    if (cs.display === 'none' || cs.visibility === 'hidden') return;
