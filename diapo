EXTRAER_JS = r"""
(n) => {
  const deck = document.getElementById('deck');
  const slides = [...deck.querySelectorAll(':scope > section.slide')];
  const s = slides[n];
  (window.diapo || window.deckAPI).go(n);
  const col = c => {
    if (!c) return null;
    let m = c.match(/^rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)(?:\s*[,/]\s*([\d.]+%?))?\s*\)$/), r, g, b, a = 1;
    if (m) { r = +m[1]; g = +m[2]; b = +m[3]; if (m[4] != null) a = m[4].endsWith('%') ? parseFloat(m[4]) / 100 : +m[4]; }
    else if ((m = c.match(/^color\(srgb\s+([-\d.e]+)\s+([-\d.e]+)\s+([-\d.e]+)(?:\s*\/\s*([\d.e]+%?))?\s*\)$/))) {
      r = m[1] * 255; g = m[2] * 255; b = m[3] * 255; if (m[4] != null) a = m[4].endsWith('%') ? parseFloat(m[4]) / 100 : +m[4];
    } else return null;
    if (a <= 0.01) return null;
    const h = x => Math.max(0, Math.min(255, Math.round(x))).toString(16).padStart(2, '0');
    return {hex: h(r) + h(g) + h(b), a: +(+a).toFixed(3)};
  };
  const familia = f => (f || '').split(',')[0].trim().replace(/^["']|["']$/g, '');
  const estilo = (cs, nodo) => {
    const a = nodo && nodo.closest ? nodo.closest('a[href]') : null;
    return {font: familia(cs.fontFamily), size: parseFloat(cs.fontSize), bold: (parseInt(cs.fontWeight, 10) || 400) >= 600,
            italic: cs.fontStyle === 'italic', underline: (cs.textDecorationLine || '').includes('underline'),
            color: col(cs.color), href: a ? a.href : null, upper: cs.textTransform === 'uppercase'};
  };
  const esBloque = d => !/^inline/.test(d) && d !== 'contents' && d !== 'none';
  const parrafos = el => {
    const ps = []; let cur = null;
    const nuevo = blk => {
      const cs = getComputedStyle(blk);
      cur = {align: cs.textAlign, lh: (parseFloat(cs.lineHeight) || parseFloat(cs.fontSize) * 1.25) / parseFloat(cs.fontSize),
             after: parseFloat(cs.marginBottom) || 0, runs: []};
      ps.push(cur);
      if (blk !== el) {
        const bf = getComputedStyle(blk, '::before');
        const t = (bf.content || '').replace(/^["']|["']$/g, '');
        if (bf.content && bf.content !== 'none' && bf.content !== 'normal' && t.trim()) cur.runs.push({...estilo(bf, blk), t: t + ' '});
      }
    };
    const walk = (nodo, blk) => {
      for (const ch of nodo.childNodes) {
        if (ch.nodeType === 3) {
          const t = ch.nodeValue.replace(/\s+/g, ' ');
          if (!t || (!cur && !t.trim())) continue;
          if (!cur) nuevo(blk);
          cur.runs.push({...estilo(getComputedStyle(ch.parentNode), ch.parentNode), t});
        } else if (ch.nodeType === 1) {
          if (ch.matches('aside.notas')) continue;
          const cs = getComputedStyle(ch);
          if (cs.display === 'none') continue;
          if (ch.tagName === 'BR') { if (!cur) nuevo(blk); cur.runs.push({br: true, t: ''}); continue; }
          if (esBloque(cs.display)) { cur = null; nuevo(ch); walk(ch, ch); cur = null; }
          else walk(ch, blk);
        }
      }
    };
    walk(el, el);
    ps.forEach(p => {
      const txt = p.runs.filter(r => !r.br);
      if (txt.length) { txt[0].t = txt[0].t.replace(/^\s+/, ''); txt[txt.length - 1].t = txt[txt.length - 1].t.replace(/\s+$/, ''); }
      p.runs = p.runs.filter(r => r.br || r.t);
      p.runs.forEach(r => { if (r.upper) r.t = r.t.toUpperCase(); });
