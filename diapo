def main() -> None:
    ap = argparse.ArgumentParser(prog='diapo', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd', metavar='COMANDO')

    s = sub.add_parser('nuevo', help='crear una presentación a partir de un tema')
    s.add_argument('carpeta', help='carpeta nueva (o ruta .html)')
    s.add_argument('--tema', default='oscuro', help='oscuro (charlas) o claro (clases); ver: diapo temas')
    s.add_argument('--titulo', help='título de la presentación')
    s.add_argument('--desde', help='guion en markdown: una slide por bloque separado con ---')
    s.set_defaults(fn=cmd_nuevo)

    s = sub.add_parser('agregar', help='sumar slides escritas en un guion markdown a una presentación')
    s.add_argument('archivo')
    s.add_argument('--desde', required=True, help='guion en markdown: una slide por bloque separado con ---')
    s.add_argument('--despues', type=int, help='después de qué slide (0 = al principio; por defecto, al final)')
    s.set_defaults(fn=cmd_agregar)

    s = sub.add_parser('imagen', help='traer una imagen (archivo o URL) a img/ y ponerla en un recuadro')
    s.add_argument('archivo')
    s.add_argument('fuente', help='ruta o URL de la imagen')
    s.add_argument('--hueco', help='recuadro a reemplazar: N (el primero de la slide N) o N:K')
    s.add_argument('--alt', help='texto alternativo (por defecto, el del recuadro)')
    s.set_defaults(fn=cmd_imagen)

    s = sub.add_parser('qr', help='código QR de un link, en img/ y opcionalmente en un recuadro')
    s.add_argument('archivo')
    s.add_argument('url')
    s.add_argument('--hueco', help='recuadro a reemplazar: N o N:K')
    s.set_defaults(fn=cmd_qr)

    s = sub.add_parser('importar', help='convertir un .pptx o .pdf')
    s.add_argument('archivo', help='.pptx (PowerPoint o Google Slides bajado como PowerPoint) o .pdf')
    s.add_argument('--salida', help='carpeta de salida (por defecto, NOMBRE-diapo al lado del original)')
    s.add_argument('--titulo', help='título de la presentación')
    s.add_argument('--tema', default='claro', help='tema para las páginas de un PDF')
    s.add_argument('--sin-fuentes', action='store_true', help='no bajar las tipografías de Google Fonts')
    s.add_argument('--pisar', action='store_true', help='reemplazar una importación anterior (queda un respaldo)')
    s.set_defaults(fn=cmd_importar)

    s = sub.add_parser('ver', help='abrir con servidor local: guarda directo y recarga si Claude cambia el archivo')
    s.add_argument('archivo', help='presentación .html (o su carpeta)')
    s.add_argument('--puerto', type=int, default=8765)
    s.add_argument('--no-abrir', action='store_true', help='no abrir el navegador')
    s.add_argument('--editar', action='store_true', help='abrir directo en modo edición')
    s.add_argument('--modelo', help='modelo para el chat: opus (por defecto, o el de diapo config) o sonnet para cambios rápidos')
    s.set_defaults(fn=cmd_ver)

    s = sub.add_parser('revisar', help='buscar problemas y sacar capturas de cada slide')
    s.add_argument('archivo')
    s.add_argument('--slides', help='cuáles, por ejemplo 3,5-7')
    s.add_argument('--salida', help='carpeta para las capturas (por defecto .diapo/revision)')
    s.add_argument('--sin-capturas', action='store_true')
    s.add_argument('--json', action='store_true', help='salida para leer con un programa')
    s.set_defaults(fn=cmd_revisar)

    s = sub.add_parser('pdf', help='exportar a PDF, una slide por página')
    s.add_argument('archivo')
    s.add_argument('-o', '--salida', help='PDF de salida (por defecto, al lado del .html)')
    s.set_defaults(fn=cmd_pdf)

    s = sub.add_parser('pptx', help='exportar a PowerPoint, con textos editables (para subir a Google Slides)')
    s.add_argument('archivo')
    s.add_argument('-o', '--salida', help='.pptx de salida (por defecto, al lado del .html)')
    s.add_argument('--imagenes', action='store_true', help='cada slide como una imagen: idéntica, pero sin texto editable')
    s.set_defaults(fn=cmd_pptx)

    s = sub.add_parser('pedidos', help='listar los pedidos a Claude')
    s.add_argument('archivo')
    s.add_argument('--json', action='store_true')
    s.set_defaults(fn=cmd_pedidos)

    s = sub.add_parser('actualizar', help='poner al día el motor de una presentación')
    s.add_argument('archivo')
    s.set_defaults(fn=cmd_actualizar)

    s = sub.add_parser('previa', help='copia solo para mirar, lista para publicar como artifact')
    s.add_argument('archivo')
    s.add_argument('--titulo', help='otro título para la copia')
    s.set_defaults(fn=cmd_previa)

    s = sub.add_parser('temas', help='ver los temas disponibles')
    s.set_defaults(fn=cmd_temas)

    s = sub.add_parser('config', help='tu nombre y tu mail para la portada de las presentaciones nuevas')
    s.add_argument('--nombre')
    s.add_argument('--mail')
    s.add_argument('--modelo-chat', dest='modelo_chat', help='modelo del chat de diapo ver: opus, sonnet, haiku o un id completo')
    s.set_defaults(fn=cmd_config)

    a = ap.parse_args()
    if not getattr(a, 'fn', None):
        ap.print_help()
        return
    a.fn(a)


if __name__ == '__main__':
    main()
