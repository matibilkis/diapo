class Contexto:
    """Colores, tipografías y estilos de texto de un patrón (master)."""

    def __init__(self, imp: 'Pptx', master_part: str):
        self.part = master_part
        self.tree = imp.xml(master_part)
        theme = next((imp.target(master_part, t) for t, typ, _ in imp.rels(master_part).values() if typ.endswith('/theme')), None)
        self.colores: dict[str, str] = {}
        self.mayor = self.menor = 'Arial'
        if theme and theme in imp.names:
            th = imp.xml(theme)
            cs = th.find(f'.//{A}clrScheme')
            for c in (cs if cs is not None else []):
                if not len(c):
                    continue
                ch = c[0]
                if local(ch.tag) == 'srgbClr':
                    self.colores[local(c.tag)] = ch.get('val')
                elif local(ch.tag) == 'sysClr':
                    self.colores[local(c.tag)] = ch.get('lastClr') or ('000000' if ch.get('val') == 'windowText' else 'FFFFFF')
            fs = th.find(f'.//{A}fontScheme')
            if fs is not None:
                mj, mn = fs.find(f'{A}majorFont/{A}latin'), fs.find(f'{A}minorFont/{A}latin')
                self.mayor = (mj.get('typeface') if mj is not None else None) or 'Arial'
                self.menor = (mn.get('typeface') if mn is not None else None) or 'Arial'
        cm = self.tree.find(f'{P}clrMap')
        self.clrmap = dict(cm.attrib) if cm is not None else {'bg1': 'lt1', 'tx1': 'dk1', 'bg2': 'lt2', 'tx2': 'dk2'}
        self.txstyles = self.tree.find(f'{P}txStyles')


IMG_LADO_MAX = 1920


def achicar_imagen(data: bytes, ext: str) -> tuple[bytes, str]:
    """Pasa a WebP y limita el lado mayor; se queda con el original si no gana."""
    if ext == '.gif':
        return achicar_gif(data)
    if ext not in ('.png', '.jpg', '.jpeg', '.webp', '.bmp', '.tif', '.tiff'):
        return data, ext
    try:
        from PIL import Image
        im = Image.open(io.BytesIO(data))
        im.load()
    except Exception:
        return data, ext
    if max(im.size) > IMG_LADO_MAX:
        im.thumbnail((IMG_LADO_MAX, IMG_LADO_MAX), Image.LANCZOS)
    alfa = im.mode in ('RGBA', 'LA') or (im.mode == 'P' and 'transparency' in im.info)
    im = im.convert('RGBA' if alfa else 'RGB')
    buf = io.BytesIO()
    im.save(buf, 'WEBP', quality=85, method=2)
    nuevo = buf.getvalue()
    return (nuevo, '.webp') if len(nuevo) < len(data) else (data, ext)


def achicar_gif(data: bytes, lado: int = 1280) -> tuple[bytes, str]:
    try:
        from PIL import Image, ImageSequence
        im = Image.open(io.BytesIO(data))
        cuadros, tiempos = [], []
        for c in ImageSequence.Iterator(im):
            tiempos.append(c.info.get('duration') or im.info.get('duration') or 100)
            c = c.convert('RGBA')
            if max(c.size) > lado:
                c.thumbnail((lado, lado), Image.LANCZOS)
            cuadros.append(c)
        buf = io.BytesIO()
        cuadros[0].save(buf, 'WEBP', save_all=True, append_images=cuadros[1:], duration=tiempos,
                        loop=im.info.get('loop', 0), quality=75, method=2)
        nuevo = buf.getvalue()
    except Exception:
        return data, '.gif'
    return (nuevo, '.webp') if len(nuevo) < len(data) else (data, '.gif')


class Pptx:
    def __init__(self, path: Path, carpeta: Path, ancho: int = 1280):
        self.z = zipfile.ZipFile(path)
        self.names = set(self.z.namelist())
        self.rels_cache: dict = {}
        pres = self.xml('ppt/presentation.xml')
        sz = pres.find(f'{P}sldSz')
        self.cx, self.cy = int(sz.get('cx')), int(sz.get('cy'))
        self.W = ancho
        self.k = ancho / self.cx
        self.H = round(self.cy * self.k)
        self.ptpx = 12700 * self.k
        rels = self.rels('ppt/presentation.xml')
        lst = pres.find(f'{P}sldIdLst')
        self.slides = [self.target('ppt/presentation.xml', rels[s.get(R + 'id')][0]) for s in (lst if lst is not None else [])]
        self.default_text = pres.find(f'{P}defaultTextStyle')
        self.carpeta = carpeta
        self.img_dir = carpeta / 'img'
        self.cache: dict = {}
        self.usados: set = set()
        self.ctxs: dict[str, Contexto] = {}
        self.stats = Counter()
        self.familias: dict = {}
        self.numero = None
        self.slide_n = 0
        self.bytes_orig = self.bytes_final = 0

    # --- partes del zip
    def xml(self, part: str):
        return ET.fromstring(self.z.read(part))

    def rels(self, part: str) -> dict:
        if part in self.rels_cache:
            return self.rels_cache[part]
        rp = posixpath.join(posixpath.dirname(part), '_rels', posixpath.basename(part) + '.rels')
        out = {}
        if rp in self.names:
            for r in ET.fromstring(self.z.read(rp)):
                out[r.get('Id')] = (r.get('Target'), r.get('Type', ''), r.get('TargetMode', ''))
        self.rels_cache[part] = out
        return out

    def target(self, part: str, t: str) -> str:
        return posixpath.normpath(posixpath.join(posixpath.dirname(part), t))

    def rel_de_tipo(self, part: str, sufijo: str) -> str | None:
        return next((self.target(part, t) for t, typ, mode in self.rels(part).values() if typ.endswith(sufijo) and mode != 'External'), None)

    # --- colores
    def color(self, ctx: Contexto, parent) -> str | None:
        if parent is None:
            return None
        for ch in parent:
            t = local(ch.tag)
            if t == 'srgbClr':
                base = ch.get('val')
            elif t == 'schemeClr':
                v = ch.get('val')
                if v == 'phClr':
                    return None
                base = ctx.colores.get(ctx.clrmap.get(v, v))
            elif t == 'sysClr':
                base = ch.get('lastClr') or ('000000' if ch.get('val') == 'windowText' else 'FFFFFF')
            elif t == 'prstClr':
                base = PRST_COLOR.get(ch.get('val'), '000000')
            elif t == 'scrgbClr':
                base = '%02x%02x%02x' % tuple(round(min(int(ch.get(k, '0')) / 100000, 1) * 255) for k in ('r', 'g', 'b'))
            else:
                continue
            if not base:
                return None
            return self.mods(base, ch)
        return None

    def esquema(self, ctx: Contexto, nombre: str) -> str | None:
        base = ctx.colores.get(ctx.clrmap.get(nombre, nombre))
        return f'#{base.lower()}' if base else None

    @staticmethod
    def mods(base: str, el) -> str:
        r, g, b = (int(base[i:i + 2], 16) / 255 for i in (0, 2, 4))
        alpha = 1.0
        for m in el:
            t, v = local(m.tag), int(m.get('val', '0')) / 100000
            if t in ('lumMod', 'lumOff', 'satMod'):
                h, l, s = colorsys.rgb_to_hls(r, g, b)
                if t == 'lumMod':
                    l *= v
                elif t == 'lumOff':
                    l += v
                else:
                    s *= v
                r, g, b = colorsys.hls_to_rgb(h, min(max(l, 0), 1), min(max(s, 0), 1))
            elif t == 'tint':
                r, g, b = (1 - (1 - c) * v for c in (r, g, b))
            elif t == 'shade':
                r, g, b = (c * v for c in (r, g, b))
            elif t == 'alpha':
                alpha = v
        rgb = tuple(round(min(max(c, 0), 1) * 255) for c in (r, g, b))
        if alpha < 0.999:
            return f'rgba({rgb[0]},{rgb[1]},{rgb[2]},{alpha:.2f})'
        return '#%02x%02x%02x' % rgb

    def gradiente(self, ctx, gf) -> str | None:
        stops = []
        for gs in gf.findall(f'{A}gsLst/{A}gs'):
            c = self.color(ctx, gs)
            if c:
                stops.append(f'{c} {int(gs.get("pos", "0")) / 1000:.0f}%')
        lin = gf.find(f'{A}lin')
        ang = int(lin.get('ang', '0')) / 60000 if lin is not None else 0
        return f'linear-gradient({ang + 90:.0f}deg,{",".join(stops)})' if stops else None

    def relleno(self, ctx, spPr, style) -> str | None:
        if spPr is not None:
            if spPr.find(f'{A}noFill') is not None:
                return None
            sf = spPr.find(f'{A}solidFill')
            if sf is not None:
                return self.color(ctx, sf)
            gf = spPr.find(f'{A}gradFill')
            if gf is not None:
                return self.gradiente(ctx, gf)
            pf = spPr.find(f'{A}pattFill')
            if pf is not None:
                return self.color(ctx, pf.find(f'{A}fgClr'))
            if spPr.find(f'{A}blipFill') is not None:
                return None
        if style is not None:
            fr = style.find(f'{A}fillRef')
            if fr is not None and fr.get('idx') not in (None, '0'):
                return self.color(ctx, fr)
        return None

    def linea(self, ctx, spPr, style):
        ln = spPr.find(f'{A}ln') if spPr is not None else None
        ancho = None
        if ln is not None:
            if ln.find(f'{A}noFill') is not None:
                return None
            ancho = max(int(ln.get('w', '12700')) * self.k, 1)
            c = self.color(ctx, ln.find(f'{A}solidFill'))
            if c:
                dash = ln.find(f'{A}prstDash')
                return ancho, c, 'dashed' if dash is not None and dash.get('val') not in (None, 'solid') else 'solid'
        if style is not None:
            lr = style.find(f'{A}lnRef')
            if lr is not None and lr.get('idx') not in (None, '0'):
                c = self.color(ctx, lr)
                if c:
                    return ancho or max(9525 * self.k, 1), c, 'solid'
        return None

    # --- estilos de texto en cascada
    @staticmethod
    def nivel(lst, lvl: int):
        return lst.find(f'{A}lvl{lvl + 1}pPr') if lst is not None else None

    @staticmethod
    def props_r(rPr) -> dict:
        d = {}
        if rPr is None:
            return d
        for k in ('sz', 'b', 'i', 'u', 'strike', 'baseline', 'cap'):
            if rPr.get(k) is not None:
                d[k] = rPr.get(k)
        lat = rPr.find(f'{A}latin')
        if lat is not None and lat.get('typeface'):
            d['latin'] = lat.get('typeface')
        sf = rPr.find(f'{A}solidFill')
        if sf is not None:
            d['fill'] = sf
        if rPr.find(f'{A}noFill') is not None:
            d['nofill'] = True
        hl = rPr.find(f'{A}hlinkClick')
        if hl is not None and hl.get(R + 'id'):
            d['link'] = hl.get(R + 'id')
        return d

    def props_p(self, pPr) -> dict:
        d = {}
        if pPr is None:
            return d
        for k in ('algn', 'marL', 'indent'):
            if pPr.get(k) is not None:
                d[k] = pPr.get(k)
        for t in ('lnSpc', 'spcBef', 'spcAft'):
            e = pPr.find(A + t)
            if e is not None:
                pct, pts = e.find(f'{A}spcPct'), e.find(f'{A}spcPts')
                if pct is not None:
                    d[t] = ('pct', int(pct.get('val')))
                elif pts is not None:
                    d[t] = ('pts', int(pts.get('val')))
        if pPr.find(f'{A}buNone') is not None:
            d['bu'] = None
        elif pPr.find(f'{A}buChar') is not None:
            d['bu'] = ('char', pPr.find(f'{A}buChar').get('char', '•'))
        elif pPr.find(f'{A}buAutoNum') is not None:
            an = pPr.find(f'{A}buAutoNum')
            d['bu'] = ('num', an.get('type', 'arabicPeriod'), int(an.get('startAt', '1')))
        bf = pPr.find(f'{A}buFont')
        if bf is not None:
            d['buFont'] = bf.get('typeface', '')
        bc = pPr.find(f'{A}buClr')
        if bc is not None:
            d['buClr'] = bc
        d['defRPr'] = self.props_r(pPr.find(f'{A}defRPr'))
        return d

    @staticmethod
    def ph(sp):
        ph = sp.find(f'.//{P}nvPr/{P}ph')
        if ph is None:
            return None
        return ph.get('type', 'body'), ph.get('idx')

    @staticmethod
    def buscar_ph(tree, tipo: str, idx: str | None):
        if tree is None:
            return None
        norm = {'ctrTitle': 'title', 'subTitle': 'body', 'obj': 'body'}
        cands = []
        for sp in tree.iter():
            if local(sp.tag) not in ('sp', 'pic'):
                continue
            ph = sp.find(f'.//{P}nvPr/{P}ph')
            if ph is not None:
                cands.append((sp, ph.get('type', 'body'), ph.get('idx')))
        if idx is not None:
            for sp, t, i in cands:
                if i == idx:
                    return sp
        for sp, t, i in cands:
            if t == tipo:
                return sp
        for sp, t, i in cands:
            if norm.get(t, t) == norm.get(tipo, tipo):
                return sp
        return None

    def cascada(self, ctx: Contexto, sp, lay, lvl: int):
        capas = []
        info = self.ph(sp)
        if info:
            tipo, idx = info
            nombre = 'titleStyle' if tipo in ('title', 'ctrTitle') else 'bodyStyle' if tipo in ('body', 'subTitle', 'obj') else 'otherStyle'
            if ctx.txstyles is not None:
                capas.append(self.nivel(ctx.txstyles.find(P + nombre), lvl))
            msp = self.buscar_ph(ctx.tree, tipo, None)
            if msp is not None:
                capas.append(self.nivel(msp.find(f'{P}txBody/{A}lstStyle'), lvl))
            lsp = self.buscar_ph(lay, tipo, idx)
            if lsp is not None:
                capas.append(self.nivel(lsp.find(f'{P}txBody/{A}lstStyle'), lvl))
        else:
            capas.append(self.nivel(self.default_text, lvl))
            if ctx.txstyles is not None:
                capas.append(self.nivel(ctx.txstyles.find(f'{P}otherStyle'), lvl))
        capas.append(self.nivel(sp.find(f'{P}txBody/{A}lstStyle'), lvl))
        pd, rd = {}, {}
        for c in capas:
            d = self.props_p(c)
            rd.update(d.pop('defRPr', {}))
            pd.update(d)
        return pd, rd

    def cuerpo_props(self, ctx, sp, lay) -> dict:
        d = {}
        chain = []
        info = self.ph(sp)
        if info:
            msp = self.buscar_ph(ctx.tree, info[0], None)
            lsp = self.buscar_ph(lay, info[0], info[1])
            chain += [x for x in (msp, lsp) if x is not None]
        chain.append(sp)
        for s in chain:
            bp = s.find(f'{P}txBody/{A}bodyPr')
            if bp is None:
                continue
            for k in ('anchor', 'lIns', 'tIns', 'rIns', 'bIns', 'wrap'):
                if bp.get(k) is not None:
                    d[k] = bp.get(k)
            na = bp.find(f'{A}normAutofit')
            if na is not None:
                d['fontScale'] = int(na.get('fontScale', '100000'))
                d['lnRed'] = int(na.get('lnSpcReduction', '0'))
        return d

    def registrar(self, fam: str, peso: int, italica: bool) -> None:
        info = self.familias.setdefault(fam, {'pesos': set(), 'italica': False})
        info['pesos'].add(peso)
        info['italica'] = info['italica'] or italica

    def run_css(self, ctx: Contexto, rp: dict, escala: float) -> dict:
        css = {}
        sz = int(rp['sz']) / 100 if rp.get('sz') else 18
        tam = sz * self.ptpx * escala
        face = rp.get('latin') or '+mn-lt'
        if face.startswith('+mj'):
            face = ctx.mayor
        elif face.startswith('+'):
            face = ctx.menor
        fam, peso = separar_peso(face)
        w = peso or 400
        if es_verdad(rp.get('b')):
            w = max(w, 700)
        italica = es_verdad(rp.get('i'))
        self.registrar(fam, w, italica)
        css['font-family'] = familia_css(fam)
        css['font-weight'] = str(w)
        if italica:
            css['font-style'] = 'italic'
        deco = []
        if rp.get('u') not in (None, 'none'):
            deco.append('underline')
        if rp.get('strike') not in (None, 'noStrike'):
            deco.append('line-through')
        if deco:
            css['text-decoration'] = ' '.join(deco)
        if rp.get('nofill'):
            css['color'] = 'transparent'
        else:
            c = self.color(ctx, rp.get('fill')) if rp.get('fill') is not None else None
            css['color'] = c or self.esquema(ctx, 'tx1') or '#000000'
        bl = rp.get('baseline')
        if bl and bl != '0':
            css['vertical-align'] = 'super' if int(bl) > 0 else 'sub'
            tam *= 0.7
        css['font-size'] = px(tam)
        if rp.get('cap') == 'all':
            css['text-transform'] = 'uppercase'
        elif rp.get('cap') == 'small':
            css['font-variant'] = 'small-caps'
        return css

    def texto(self, ctx, sp, lay, txBody, rels_part: str, num: int):
        """Devuelve (html interno, css común del texto, css del cuerpo) o None si no hay texto."""
        bp = self.cuerpo_props(ctx, sp, lay) if sp is not None else {}
        escala = bp.get('fontScale', 100000) / 100000
        red = bp.get('lnRed', 0) / 100000
        parrafos = []
        hay_texto = False
        for p in txBody.findall(f'{A}p'):
            pPr = p.find(f'{A}pPr')
            lvl = int(pPr.get('lvl', '0')) if pPr is not None else 0
            pd, rd = self.cascada(ctx, sp, lay, lvl) if sp is not None else ({}, {})
            own = self.props_p(pPr)
            rd = {**rd, **own.pop('defRPr', {})}
            pd = {**pd, **own}
            items = []
            for node in p:
                t = local(node.tag)
                if t in ('r', 'fld'):
                    rp = {**rd, **self.props_r(node.find(f'{A}rPr'))}
                    txt = node.findtext(f'{A}t') or ''
                    if t == 'fld' and node.get('type') == 'slidenum':
                        txt = str(num)
                    if txt.strip():
                        hay_texto = True
                    items.append(('r', self.run_css(ctx, rp, escala), txt, rp.get('link')))
                elif t == 'br':
                    items.append(('br',))
            end = p.find(f'{A}endParaRPr')
            end_css = self.run_css(ctx, {**rd, **self.props_r(end)}, escala)
            parrafos.append((pd, items, end_css))
        if not hay_texto:
            return None
        cuenta = Counter()
        for pd, items, end_css in parrafos:
            for it in items:
                if it[0] == 'r' and it[2].strip():
                    cuenta[tuple(sorted(it[1].items()))] += len(it[2])
        dom = dict(cuenta.most_common(1)[0][0]) if cuenta else {}
        rels = self.rels(rels_part)
        html_ps = []
        contadores: dict[int, int] = {}
        alineacion = next((pd.get('algn', 'l') for pd, items, _ in parrafos if any(it[0] == 'r' and it[2].strip() for it in items)), 'l')
        for pd, items, end_css in parrafos:
            pcss = {}
            algn = pd.get('algn')
            if algn in ('ctr', 'r', 'just', 'dist'):
                pcss['text-align'] = {'ctr': 'center', 'r': 'right', 'just': 'justify', 'dist': 'justify'}[algn]
            ln = pd.get('lnSpc')
            if ln:
                pcss['line-height'] = f'{max(ln[1] / 100000 * 1.2 - red, 0.6):.2f}' if ln[0] == 'pct' else px(ln[1] / 100 * self.ptpx)
            else:
                pcss['line-height'] = f'{max(1.2 - red, 0.6):.2f}'
            for k, prop in (('spcBef', 'margin-top'), ('spcAft', 'margin-bottom')):
                v = pd.get(k)
                if v and v[1]:
                    pcss[prop] = px(v[1] / 100 * self.ptpx) if v[0] == 'pts' else f'{v[1] / 100000 * 1.2:.2f}em'
            marl = int(pd.get('marL', '0')) * self.k
            ind = int(pd.get('indent', '0')) * self.k
            texto_p = any(it[0] == 'r' and it[2].strip() for it in items)
            bu = pd.get('bu') if texto_p else None
            if marl or ind:
                pcss['padding-left'] = px(marl)
                if ind:
                    pcss['text-indent'] = px(ind)
            vineta = ''
            if bu:
                lvl_key = int(round(marl))
                if bu[0] == 'char':
                    ch = bu[1]
                    if 'wingding' in pd.get('buFont', '').lower() or 'symbol' in pd.get('buFont', '').lower():
                        ch = WINGDINGS.get(ch, '•')
                    contadores.pop(lvl_key, None)
                else:
                    n = contadores.get(lvl_key, bu[2] - 1) + 1
                    contadores[lvl_key] = n
                    ch = self.numerar(bu[1], n)
                bcol = self.color(ctx, pd.get('buClr')) if pd.get('buClr') is not None else None
                vineta = f'<span style="{css_str({"color": bcol})}">{esc(ch)}</span>&nbsp;' if bcol else f'{esc(ch)}&nbsp;'
            else:
                contadores.clear() if not texto_p else None
            partes = []
            for it in items:
                if it[0] == 'br':
                    partes.append('<br>')
                    continue
                _, rcss, txt, link = it
                if not txt:
                    continue
                dif = {k: v for k, v in rcss.items() if dom.get(k) != v}
                if not txt.strip():
                    dif = {k: v for k, v in dif.items() if k in ('font-size',)}
                h = esc(txt).replace('  ', '&nbsp; ')
                if dif:
                    h = f'<span style="{css_str(dif)}">{h}</span>'
                if link and link in rels and rels[link][2] == 'External':
                    acss = {k: v for k, v in rcss.items() if k in ('color', 'text-decoration')}
                    h = f'<a href="{esc(rels[link][0])}" target="_blank" rel="noopener" style="{css_str(acss)}">{h}</a>'
                partes.append(h)
            if not texto_p and not partes:
                tam = end_css.get('font-size')
                if tam and tam != dom.get('font-size'):
                    pcss['font-size'] = tam
                html_ps.append(f'<p style="{css_str(pcss)}"><br></p>')
            else:
                html_ps.append(f'<p style="{css_str(pcss)}">{vineta}{"".join(partes)}</p>')
        cuerpo = {}
        ins = [int(bp.get(k, d)) * self.k for k, d in (('tIns', 45720), ('rIns', 91440), ('bIns', 45720), ('lIns', 91440))]
        cuerpo['padding'] = ' '.join(px(v) for v in ins)
        if bp.get('wrap') == 'none':
            cuerpo['white-space'] = 'nowrap'
        anchor = bp.get('anchor', 't')
        if anchor in ('ctr', 'b'):
            cuerpo['display'] = 'flex'
            cuerpo['flex-direction'] = 'column'
            cuerpo['justify-content'] = 'center' if anchor == 'ctr' else 'flex-end'
        return ''.join(html_ps), dom, cuerpo, alineacion

    @staticmethod
    def numerar(tipo: str, n: int) -> str:
        def romano(x):
            vals = [(1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'), (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'), (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')]
            out = ''
            for v, s in vals:
                while x >= v:
                    out += s
                    x -= v
            return out
        base = (romano(n) if 'roman' in tipo.lower() else chr(96 + ((n - 1) % 26) + 1) if 'alpha' in tipo.lower() else str(n))
        if 'Uc' in tipo:
            base = base.upper()
        if tipo.endswith('ParenBoth'):
            return f'({base})'
        if tipo.endswith('ParenR'):
            return f'{base})'
        if tipo.endswith('Plain'):
            return base
        return f'{base}.'

    # --- geometría
    @staticmethod
    def xfrm(el):
        for path in (f'{P}spPr/{A}xfrm', f'{P}grpSpPr/{A}xfrm', f'{P}xfrm'):
            x = el.find(path)
            if x is not None:
                return x
        return None

    def caja(self, xf, T):
        off, ext = xf.find(f'{A}off'), xf.find(f'{A}ext')
        if off is None or ext is None:
            return None
        ax, sx, ay, sy = T
        x, y = ax + sx * int(off.get('x', '0')), ay + sy * int(off.get('y', '0'))
        w, h = sx * int(ext.get('cx', '0')), sy * int(ext.get('cy', '0'))
        return {'x': x * self.k, 'y': y * self.k, 'w': w * self.k, 'h': h * self.k,
                'rot': int(xf.get('rot', '0')) / 60000, 'fh': es_verdad(xf.get('flipH')), 'fv': es_verdad(xf.get('flipV'))}

    def caja_de(self, sp, lay, ctx, T):
        xf = self.xfrm(sp)
        if xf is None or xf.find(f'{A}off') is None:
            info = self.ph(sp)
            if info:
                for tree in (lay, ctx.tree):
                    src = self.buscar_ph(tree, info[0], info[1] if tree is lay else None)
                    if src is not None and self.xfrm(src) is not None:
                        return self.caja(self.xfrm(src), (0, 1, 0, 1))
            return None
        return self.caja(xf, T)

    def fuera(self, b) -> bool:
        return b['x'] < -2 or b['y'] < -2 or b['x'] + b['w'] > self.W + 2 or b['y'] + b['h'] > self.H + 2

    @staticmethod
    def pos_css(b) -> dict:
        css = {'left': px(b['x']), 'top': px(b['y']), 'width': px(max(b['w'], 1))}
        tr = []
        if b['rot']:
            tr.append(f'rotate({b["rot"]:.1f}deg)')
        if b['fh']:
            tr.append('scaleX(-1)')
        if b['fv']:
            tr.append('scaleY(-1)')
        if tr:
            css['transform'] = ' '.join(tr)
        return css

    # --- imágenes
    def imagen(self, part: str, rid: str | None, crop=(0, 0, 0, 0)) -> str | None:
        if not rid:
            return None
        t = self.rels(part).get(rid)
        if not t:
            return None
        target, typ, mode = t
        if mode == 'External':
            return target
        media = self.target(part, target)
        if media not in self.names:
            return None
        key = (media, tuple(crop))
        if key in self.cache:
            return self.cache[key]
        data = self.z.read(media)
        ext = Path(media).suffix.lower()
        stem = re.sub(r'[^A-Za-z0-9_-]', '', Path(media).stem) or 'imagen'
        recortar = any(crop)
        if ext in ('.emf', '.wmf', '.tif', '.tiff', '.bmp') or recortar:
            try:
                from PIL import Image
                im = Image.open(io.BytesIO(data))
                im.load()
            except Exception:
                im = self.convertir_vectorial(data, ext)
                if im is None:
                    self.stats['imágenes que no pude convertir (EMF/WMF)'] += 1
                    self.cache[key] = None
                    return None
            if recortar:
                l, tt, r, b = (c / 100000 for c in crop)
                w, h = im.size
                box = (max(0, round(w * l)), max(0, round(h * tt)), min(w, round(w * (1 - r))), min(h, round(h * (1 - b))))
                if box[2] > box[0] and box[3] > box[1]:
                    im = im.crop(box)
                self.stats['imágenes recortadas'] += 1
            con_alfa = im.mode in ('RGBA', 'LA', 'P')
            ext = '.png' if con_alfa or ext in ('.png', '.emf', '.wmf', '.bmp', '.tif', '.tiff') else '.jpg'
            buf = io.BytesIO()
            if ext == '.png':
                im.save(buf, 'PNG', optimize=True)
            else:
                im.convert('RGB').save(buf, 'JPEG', quality=90)
            data = buf.getvalue()
            stem += '-recorte' if recortar else ''
        self.bytes_orig += len(data)
        data, ext = achicar_imagen(data, ext)
        if ext == '.gif' or (ext == '.webp' and b'ANIM' in data[:64]):
            self.stats['animaciones (en el PDF quedan quietas)'] += 1
        stem = f's{self.slide_n:02d}' if self.slide_n else 'fondo'
        i = 1
        nombre = f'{stem}-{i}{ext}'
        while nombre in self.usados:
            i += 1
            nombre = f'{stem}-{i}{ext}'
        self.usados.add(nombre)
        self.bytes_final += len(data)
        self.img_dir.mkdir(parents=True, exist_ok=True)
        (self.img_dir / nombre).write_bytes(data)
        self.cache[key] = f'img/{nombre}'
        self.stats['imágenes'] += 1
        return self.cache[key]

    @staticmethod
    def convertir_vectorial(data: bytes, ext: str):
        conv = shutil.which('convert') or shutil.which('magick')
        if not conv or ext not in ('.wmf', '.emf'):
            return None
        with tempfile.TemporaryDirectory() as td:
            src, dst = Path(td) / f'in{ext}', Path(td) / 'out.png'
            src.write_bytes(data)
            try:
                subprocess.run([conv, str(src), str(dst)], check=True, capture_output=True, timeout=30)
                from PIL import Image
                im = Image.open(dst)
                im.load()
                return im
            except Exception:
                return None

    # --- elementos
    def elemento(self, n, part, tree, lay, ctx, T, num, out: list) -> None:
        t = local(n.tag)
        nv = n.find(f'.//{P}cNvPr')
        if nv is not None and es_verdad(nv.get('hidden')):
            return
        if t == 'AlternateContent':
            alt = n.find(f'{MC}Fallback')
            if alt is None:
                alt = n.find(f'{MC}Choice')
            for c in (alt if alt is not None else []):
                self.elemento(c, part, tree, lay, ctx, T, num, out)
            return
        if t == 'grpSp':
            xf = n.find(f'{P}grpSpPr/{A}xfrm')
            T2 = T
            if xf is not None and xf.find(f'{A}off') is not None and xf.find(f'{A}chExt') is not None:
                off, ext, choff, chext = (xf.find(A + k) for k in ('off', 'ext', 'chOff', 'chExt'))
                scx = int(ext.get('cx')) / max(int(chext.get('cx')), 1)
                scy = int(ext.get('cy')) / max(int(chext.get('cy')), 1)
                ax, sx, ay, sy = T
                T2 = (ax + sx * (int(off.get('x')) - int(choff.get('x')) * scx), sx * scx,
                      ay + sy * (int(off.get('y')) - int(choff.get('y')) * scy), sy * scy)
            for c in n:
                self.elemento(c, part, tree, lay, ctx, T2, num, out)
            return
        if t == 'sp':
            self.forma(n, part, lay, ctx, T, num, out)
        elif t == 'pic':
            self.foto(n, part, lay, ctx, T, out)
        elif t == 'cxnSp':
            self.conector(n, ctx, T, out)
        elif t == 'graphicFrame':
            self.marco(n, part, lay, ctx, T, num, out)

    def forma(self, sp, part, lay, ctx, T, num, out) -> None:
        info = self.ph(sp)
        tx = sp.find(f'{P}txBody')
        if info and info[0] == 'sldNum':
            if self.numero is None and tx is not None:
                r = self.texto(ctx, sp, lay, tx, part, num)
                if r:
                    self.numero = (r[1].get('color'), r[1].get('font-size'))
            return
        b = self.caja_de(sp, lay, ctx, T)
        if b is None:
            return
        spPr, style = sp.find(f'{P}spPr'), sp.find(f'{P}style')
        fondo = self.relleno(ctx, spPr, style)
        borde = self.linea(ctx, spPr, style)
        geom = spPr.find(f'{A}prstGeom') if spPr is not None else None
        prst = geom.get('prst') if geom is not None else ('custom' if spPr is not None and spPr.find(f'{A}custGeom') is not None else 'rect')
        blip = spPr.find(f'{A}blipFill') if spPr is not None else None
        texto = self.texto(ctx, sp, lay, tx, part, num) if tx is not None else None
        if info and info[0] in ('dt', 'ftr') and not texto:
            return
        css = self.pos_css(b)
        if blip is not None:
            b2 = blip.find(f'{A}blip')
            src = self.imagen(part, b2.get(R + 'embed') if b2 is not None else None)
            if src:
                cls = 'el' + (' circulo' if prst in CIRCULOS else ' cubrir')
                css['height'] = px(b['h'])
                out.append(f'<img class="{cls}" src="{esc(src)}" alt="" style="{css_str(css)}">')
                self.stats['formas con imagen'] += 1
        if not texto and not fondo and not borde:
            return
        clases = ['el'] + (['sangrado'] if self.fuera(b) else [])
        if fondo:
            css['background'] = fondo
        if borde:
            css['border'] = f'{px(borde[0])} {borde[2]} {borde[1]}'
        if prst in CIRCULOS:
            css['border-radius'] = '50%'
        elif prst == 'roundRect':
            adj = 16667
            gd = geom.find(f'{A}avLst/{A}gd') if geom is not None else None
            if gd is not None and gd.get('fmla', '').startswith('val '):
                adj = int(gd.get('fmla').split()[1])
            css['border-radius'] = px(adj / 100000 * min(b['w'], b['h']))
        elif prst in CLIP and (fondo or borde):
            css['clip-path'] = CLIP[prst]
        elif prst not in ('rect', 'line', 'custom') and (fondo or borde):
            self.stats[f'formas aproximadas como rectángulo ({prst})'] += 1
        if prst == 'custom' and (fondo or borde):
            self.stats['formas libres aproximadas como rectángulo'] += 1
        interior = ''
        if texto:
            interior, dom, cuerpo, alin = texto
            if not fondo and not borde and cuerpo.get('white-space') != 'nowrap':
                # la Montserrat de Google Fonts sale ~1% más ancha que la de Google Slides: margen para que no corte renglones
                extra = b['w'] * 0.03
                b = dict(b, x=b['x'] - (extra / 2 if alin == 'ctr' else extra if alin == 'r' else 0), w=b['w'] + extra)
                css.update(self.pos_css(b))
            css.update(cuerpo)
            css.update(dom)
            clases.append('pptx')
        if texto and (b['h'] and (fondo or borde or css.get('display') == 'flex')):
            css['height'] = px(b['h'])
        elif not texto:
            css['height'] = px(b['h'])
        out.append(f'<div class="{" ".join(clases)}" style="{css_str(css)}">{interior}</div>')
        self.stats['textos' if texto else 'formas'] += 1

    def foto(self, pic, part, lay, ctx, T, out) -> None:
        b = self.caja_de(pic, lay, ctx, T)
        if b is None:
            return
        css = self.pos_css(b)
        css['height'] = px(b['h'])
        video = pic.find(f'.//{A}videoFile')
        if video is not None or pic.find(f'.//{A}audioFile') is not None:
            href = None
            rid = video.get(R + 'link') if video is not None else None
            if rid and rid in self.rels(part):
                href = self.rels(part)[rid][0]
            aviso = 'Video' + (f'<br><a href="{esc(href)}" target="_blank" rel="noopener">abrir</a>' if href else ' (no importado)')
            out.append(f'<div class="el hueco" style="{css_str(css)}">{aviso}</div>')
            self.stats['videos (quedan como recuadro)'] += 1
            return
        blip = pic.find(f'{P}blipFill/{A}blip')
        sr = pic.find(f'{P}blipFill/{A}srcRect')
        crop = tuple(int(sr.get(k, '0')) for k in ('l', 't', 'r', 'b')) if sr is not None else (0, 0, 0, 0)
        src = None
        if blip is not None:
            src = self.imagen(part, blip.get(R + 'embed'), crop) or (self.rels(part).get(blip.get(R + 'link'), (None,))[0] if blip.get(R + 'link') else None)
        geom = pic.find(f'{P}spPr/{A}prstGeom')
        cls = 'el' + (' circulo' if geom is not None and geom.get('prst') in CIRCULOS else '') + (' sangrado' if self.fuera(b) else '')
        if not src:
            out.append(f'<div class="el hueco" style="{css_str(css)}">Imagen no importada</div>')
            return
        borde = self.linea(ctx, pic.find(f'{P}spPr'), pic.find(f'{P}style'))
        if borde:
            css['border'] = f'{px(borde[0])} {borde[2]} {borde[1]}'
        nv = pic.find(f'.//{P}cNvPr')
        alt = nv.get('descr', '') if nv is not None else ''
        out.append(f'<img class="{cls}" src="{esc(src)}" alt="{esc(alt)}" style="{css_str(css)}">')

    def conector(self, cx, ctx, T, out) -> None:
        xf = self.xfrm(cx)
        if xf is None:
            return
        b = self.caja(xf, T)
        if b is None:
            return
        borde = self.linea(ctx, cx.find(f'{P}spPr'), cx.find(f'{P}style'))
        if not borde:
            return
        x1, y1, x2, y2 = b['x'], b['y'], b['x'] + b['w'], b['y'] + b['h']
        if b['fh']:
            x1, x2 = x2, x1
        if b['fv']:
            y1, y2 = y2, y1
        largo = math.hypot(x2 - x1, y2 - y1)
        ang = math.degrees(math.atan2(y2 - y1, x2 - x1))
        css = {'left': px(x1), 'top': px(y1), 'width': px(max(largo, 1)), 'height': '0',
               'border-top': f'{px(borde[0])} {borde[2]} {borde[1]}', 'transform-origin': '0 0'}
        if abs(ang) > 0.05:
            css['transform'] = f'rotate({ang:.2f}deg)'
        out.append(f'<div class="el" style="{css_str(css)}"></div>')
        ln = cx.find(f'{P}spPr/{A}ln')
        if ln is not None and any(e is not None and e.get('type') not in (None, 'none') for e in (ln.find(f'{A}headEnd'), ln.find(f'{A}tailEnd'))):
            self.stats['flechas sin punta (línea sola)'] += 1
        self.stats['líneas'] += 1

    def marco(self, gf, part, lay, ctx, T, num, out) -> None:
        xf = self.xfrm(gf)
        b = self.caja(xf, T) if xf is not None else None
        if b is None:
            return
        css = self.pos_css(b)
        tbl = gf.find(f'.//{A}tbl')
        if tbl is None:
            css['height'] = px(b['h'])
            uri = gf.find(f'.//{A}graphicData')
            que = (uri.get('uri', '').rsplit('/', 1)[-1] if uri is not None else 'objeto')
            out.append(f'<div class="el hueco" style="{css_str(css)}">Gráfico u objeto no importado ({esc(que)})</div>')
            self.stats['gráficos u objetos (quedan como recuadro)'] += 1
            return
        cols = [int(c.get('w', '0')) * self.k for c in tbl.findall(f'{A}tblGrid/{A}gridCol')]
        filas = []
        for tr in tbl.findall(f'{A}tr'):
            celdas = []
            for tc in tr.findall(f'{A}tc'):
                if es_verdad(tc.get('hMerge')) or es_verdad(tc.get('vMerge')):
                    continue
                attrs = ''
                if tc.get('gridSpan'):
                    attrs += f' colspan="{tc.get("gridSpan")}"'
                if tc.get('rowSpan'):
                    attrs += f' rowspan="{tc.get("rowSpan")}"'
                ccss = {'border': '1px solid rgba(127,127,127,.45)'}
                tcPr = tc.find(f'{A}tcPr')
                if tcPr is not None:
                    f = self.relleno(ctx, tcPr, None)
                    if f:
                        ccss['background'] = f
                    ins = [int(tcPr.get(k, d)) * self.k for k, d in (('marT', 45720), ('marR', 91440), ('marB', 45720), ('marL', 91440))]
                    ccss['padding'] = ' '.join(px(v) for v in ins)
                tb = tc.find(f'{A}txBody')
                r = self.texto(ctx, None, lay, tb, part, num) if tb is not None else None
                interior = ''
                if r:
                    interior, dom = r[0], r[1]
                    ccss.update(dom)
                celdas.append(f'<td{attrs} style="{css_str(ccss)}">{interior}</td>')
            filas.append(f'<tr style="height:{px(int(tr.get("h", "0")) * self.k)}">{"".join(celdas)}</tr>')
        colgroup = ''.join(f'<col style="width:{px(w)}">' for w in cols)
        out.append(f'<div class="el pptx" style="{css_str(css)}"><table style="border-collapse:collapse;width:100%;table-layout:fixed"><colgroup>{colgroup}</colgroup>{"".join(filas)}</table></div>')
        self.stats['tablas'] += 1

    # --- slides
    def fondo(self, ctx, capas):
        for part, tree in capas:
            bg = tree.find(f'{P}cSld/{P}bg')
            if bg is None:
                continue
            bgPr = bg.find(f'{P}bgPr')
            if bgPr is not None:
                bf = bgPr.find(f'{A}blipFill')
                if bf is not None:
                    b = bf.find(f'{A}blip')
                    src = self.imagen(part, b.get(R + 'embed') if b is not None else None)
                    if src:
                        return 'img', src
                f = self.relleno(ctx, bgPr, None)
                if f:
                    return 'css', f
            ref = bg.find(f'{P}bgRef')
            if ref is not None:
                c = self.color(ctx, ref)
                if c:
                    return 'css', c
        return 'css', self.esquema(ctx, 'bg1') or '#ffffff'

    def notas(self, slide_part: str) -> str:
        np_ = self.rel_de_tipo(slide_part, '/notesSlide')
        if not np_ or np_ not in self.names:
            return ''
        tree = self.xml(np_)
        ps = []
        for sp in tree.iter(f'{P}sp'):
            ph = sp.find(f'.//{P}nvPr/{P}ph')
            if ph is None or ph.get('type', 'body') != 'body':
                continue
            for p in sp.iter(f'{A}p'):
                t = ''.join(x.text or '' for x in p.iter(f'{A}t')).strip()
                if t:
                    ps.append(f'<p>{esc(t)}</p>')
        return ''.join(ps)

    def titulo_slide(self, tree, n: int) -> str:
        """El título del placeholder; si no hay, el texto que está más arriba."""
        arriba = (float('inf'), '')
        for sp in tree.iter(f'{P}sp'):
            t = ' '.join(''.join((x.text or '') if x.tag == f'{A}t' else ' ' for x in p.iter() if x.tag in (f'{A}t', f'{A}br'))
                         for p in sp.iter(f'{A}p')).strip()
            t = re.sub(r'\s+', ' ', t)
            if not t:
                continue
            ph = sp.find(f'.//{P}nvPr/{P}ph')
            if ph is not None and ph.get('type') in ('title', 'ctrTitle'):
                return t[:70]
            if re.fullmatch(r'[\d‹#›]+', t) or not re.search(r'[^\W\d_]{2}', t):
                continue
            off = sp.find(f'{P}spPr/{A}xfrm/{A}off')
            y = int(off.get('y', 0)) if off is not None else float('inf')
            if y < arriba[0] or not arriba[1]:
                arriba = (y, t[:70])
        return arriba[1] or f'Slide {n}'

    def slide(self, part: str, n: int) -> str:
        self.slide_n = n
        tree = self.xml(part)
        lay_part = self.rel_de_tipo(part, '/slideLayout')
        lay = self.xml(lay_part) if lay_part and lay_part in self.names else None
        mas_part = self.rel_de_tipo(lay_part, '/slideMaster') if lay_part else None
        if mas_part not in self.ctxs and mas_part:
            self.ctxs[mas_part] = Contexto(self, mas_part)
        ctx = self.ctxs.get(mas_part) or next(iter(self.ctxs.values()))
        capas = [(part, tree)] + ([(lay_part, lay)] if lay is not None else []) + [(ctx.part, ctx.tree)]
        tipo, valor = self.fondo(ctx, capas)
        elementos = []
        if tipo == 'img':
            elementos.append(f'<img class="el cubrir" src="{esc(valor)}" alt="" style="left:0px;top:0px;width:{self.W}px;height:{self.H}px">')
        T = (0, 1, 0, 1)
        if lay is not None and (tree.get('showMasterSp') != '0'):
            pass  # los dibujos fijos del layout se agregan abajo, antes del contenido de la slide
        for fuente_part, fuente_tree in ([(lay_part, lay)] if lay is not None else []):
            for n2 in fuente_tree.find(f'{P}cSld/{P}spTree') if fuente_tree.find(f'{P}cSld/{P}spTree') is not None else []:
                if local(n2.tag) in ('sp', 'pic') and n2.find(f'.//{P}nvPr/{P}ph') is not None:
                    continue
                if local(n2.tag) in ('sp', 'pic', 'grpSp', 'cxnSp'):
                    self.elemento(n2, fuente_part, fuente_tree, None, ctx, T, n, elementos)
        sptree = tree.find(f'{P}cSld/{P}spTree')
        for node in (sptree if sptree is not None else []):
            self.elemento(node, part, tree, lay, ctx, T, n, elementos)
        titulo = self.titulo_slide(tree, n)
        if tree.get('show') == '0':
            titulo = '(oculta) ' + titulo
        estilo = f' style="background:{valor}"' if tipo == 'css' and valor != getattr(self, 'fondo_base', None) else ''
        notas = self.notas(part)
        cuerpo = '\n  '.join(elementos)
        return f'<section class="slide" data-titulo="{esc(titulo)}"{estilo}>\n  {cuerpo}\n  <aside class="notas">{notas}</aside>\n</section>'

    def convertir(self) -> str:
        if not self.slides:
            die('el archivo no tiene slides.')
        primero = self.xml(self.slides[0])
        lay_part = self.rel_de_tipo(self.slides[0], '/slideLayout')
        mas_part = self.rel_de_tipo(lay_part, '/slideMaster') if lay_part else None
        if mas_part:
            self.ctxs[mas_part] = Contexto(self, mas_part)
            ctx = self.ctxs[mas_part]
            tipo, valor = self.fondo(ctx, [(mas_part, ctx.tree)])
            self.fondo_base = valor if tipo == 'css' else None
        secciones = [self.slide(p, i + 1) for i, p in enumerate(self.slides)]
        return '\n\n'.join(secciones)


def estilos_importados() -> str:
    return """/* ===== ESTILOS · importados; los marcados «estilo:» aparecen en el selector de la barra ===== */
.el.pptx p{margin:0}
.slide a{color:var(--link)}
/* estilo: Título */ .titulo{font:700 40px/1.2 var(--f-titulo);color:var(--texto)}
/* estilo: Cuerpo */ .cuerpo{font:400 24px/1.35 var(--f-cuerpo);color:var(--texto)}
/* estilo: Chico */ .chico{font:400 16px/1.35 var(--f-cuerpo);color:var(--texto);opacity:.7}
/* estilo: Destacado */ .destacado{font:700 24px/1.3 var(--f-cuerpo);color:var(--acento)}
/* estilo: [Fuente] */ .fuente{font:700 18px/1.2 var(--f-cuerpo);color:var(--link);text-decoration:underline}
"""


def importar_pptx(src: Path, carpeta: Path, titulo: str, sin_fuentes: bool) -> tuple[str, dict]:
    imp = Pptx(src, carpeta)
    secciones = imp.convertir()
    ctx = next(iter(imp.ctxs.values()))
    def hexo(nombre, defecto):
        c = imp.esquema(ctx, nombre)
        return c if c and re.fullmatch(r'#[0-9a-f]{6}', c) else defecto
    fondo_base = getattr(imp, 'fondo_base', None)
    num_color, num_tam = (imp.numero or (None, None))
    tema = f""":root{{
  --fondo: {fondo_base if fondo_base and re.fullmatch(r'#[0-9a-f]{6}', fondo_base) else hexo('bg1', '#ffffff')};
  --texto: {hexo('tx1', '#111111')};
  --acento: {hexo('accent1', '#2b6cb0')};
  --acento2: {hexo('accent2', '#c05621')};
  --link: {hexo('hlink', '#2b6cb0')};
  --numero: {num_color if num_color and re.fullmatch(r'#[0-9a-f]{6}', num_color) else '#8a8f98'};
  --numero-tam: {num_tam or '18px'};
  --f-titulo: {familia_css(separar_peso(ctx.mayor)[0])};
  --f-cuerpo: {familia_css(separar_peso(ctx.menor)[0])};
}}"""
    for face in (ctx.mayor, ctx.menor):
        fam, peso = separar_peso(face)
        imp.registrar(fam, peso or 400, False)
        imp.registrar(fam, 700, False)
    fuentes_css, faltan = ('', []) if sin_fuentes else bajar_fuentes(imp.familias, carpeta / 'fonts')
    google = None
    if sin_fuentes or faltan:
        nombres = [f for f in (imp.familias if sin_fuentes else faltan) if f.lower() not in SISTEMA]
        if nombres:
            google = 'https://fonts.googleapis.com/css2?' + '&'.join('family=' + quote(f) for f in sorted(nombres)) + '&display=swap'
    html_ = armar(titulo, secciones, archivo=f'{carpeta.name}.html', ancho=imp.W, alto=imp.H,
                  fuentes_css=fuentes_css, tema_css=tema, estilos_css=estilos_importados(), google=google)
    info = {'slides': len(imp.slides), 'lienzo': f'{imp.W}×{imp.H}', 'detalle': dict(imp.stats),
            'peso': f'{imp.bytes_orig / 1e6:.1f} MB en el pptx → {imp.bytes_final / 1e6:.1f} MB en img/' if imp.bytes_orig else '',
            'fuentes locales': sorted(f for f in imp.familias if f.lower() not in SISTEMA and f not in faltan) if not sin_fuentes else [],
            'fuentes sin bajar': faltan}
    return html_, info


def importar_pdf(src: Path, carpeta: Path, titulo: str, tema: str) -> tuple[str, dict]:
    if not shutil.which('pdftoppm'):
        die('para importar PDF hace falta pdftoppm (paquete poppler-utils).')
    if not shutil.which('pdfinfo'):
        die('para importar PDF hace falta pdfinfo (paquete poppler-utils).')
    out = subprocess.run(['pdfinfo', str(src)], capture_output=True, text=True).stdout
    pags, m = re.search(r'Pages:\s+(\d+)', out), re.search(r'Page size:\s+([\d.]+) x ([\d.]+)', out)
    if not pags or not m:
        die(f'pdfinfo no pudo leer {src.name}; ¿está dañado o protegido?')
    paginas = int(pags.group(1))
    wpt, hpt = float(m.group(1)), float(m.group(2))
    W = 1280
    H = round(W * hpt / wpt)
    dpi = max(72, round(W * 1.25 / (wpt / 72)))
    img_dir = carpeta / 'img'
    img_dir.mkdir(parents=True, exist_ok=True)
    from PIL import Image
    secciones = []
    with tempfile.TemporaryDirectory() as td:
        subprocess.run(['pdftoppm', '-r', str(dpi), '-png', str(src), f'{td}/p'], check=True)
        pngs = sorted(Path(td).glob('p-*.png'))
        for i, png in enumerate(pngs, 1):
            nombre = f'pagina-{i:02d}.webp'
            Image.open(png).convert('RGB').save(img_dir / nombre, 'WEBP', quality=88)
            txt = subprocess.run(['pdftotext', '-f', str(i), '-l', str(i), '-layout', str(src), '-'], capture_output=True, text=True).stdout if shutil.which('pdftotext') else ''
            lineas = [re.sub(r'\s+', ' ', l).strip() for l in txt.splitlines()]
            lineas = [l for l in lineas if l]
            con_letras = [l for l in lineas if re.search(r'[^\W\d_]{2}', l)]
            titulo_p = con_letras[0][:70] if con_letras else f'Página {i}'
            notas = ('<p><i>Texto de la página, importado del PDF:</i></p>' + ''.join(f'<p>{esc(l)}</p>' for l in lineas)) if lineas else ''
            secciones.append(f'<section class="slide" data-titulo="{esc(titulo_p)}">\n  <img class="el" src="img/{nombre}" alt="Página {i}" style="left:0px;top:0px;width:{W}px">\n  <aside class="notas">{notas}</aside>\n</section>')
    tdir = tema_dir(tema)
    copiar_fuentes(tdir, carpeta)
    meta = json.loads((tdir / 'tema.json').read_text(encoding='utf-8'))
    html_ = armar(titulo, '\n\n'.join(secciones), archivo=f'{carpeta.name}.html', ancho=W, alto=H,
                  fuentes_css=(tdir / 'fuentes.css').read_text(encoding='utf-8'), tema_css=(tdir / 'tema.css').read_text(encoding='utf-8'),
                  estilos_css=(tdir / 'estilos.css').read_text(encoding='utf-8'), google=meta.get('google'))
    return html_, {'slides': paginas, 'lienzo': f'{W}×{H}', 'detalle': {'cada página es una imagen de fondo': paginas}}


def cmd_importar(a) -> None:
    src = Path(a.archivo).expanduser().resolve()
    if not src.exists():
        die(f'no existe {src}')
    ext = src.suffix.lower()
    if ext not in ('.pptx', '.pdf'):
        die('importo .pptx (PowerPoint, o Google Slides bajado como PowerPoint) o .pdf.')
    carpeta = Path(a.salida).expanduser().resolve() if a.salida else src.with_name(f'{src.stem}-diapo')
    nombre = re.sub(r'[^\w.-]+', '-', carpeta.name).strip('-') or 'presentacion'
    archivo = carpeta / f'{nombre}.html'
    if archivo.exists() and not a.pisar:
        die(f'ya existe {archivo}; usá --pisar para reemplazarla.')
    carpeta.mkdir(parents=True, exist_ok=True)
    titulo = a.titulo or src.stem
    if ext == '.pptx':
        html_, info = importar_pptx(src, carpeta, titulo, a.sin_fuentes)
    else:
        html_, info = importar_pdf(src, carpeta, titulo, a.tema)
    html_ = html_.replace(f'diapo ver {carpeta.name}.html', f'diapo ver {archivo.name}')
    if archivo.exists():
        respaldar(archivo, cada=0)
    escribir(archivo, html_)
    carpeta_oculta(carpeta)
    copiar_katex(carpeta)
    print(f'Importada: {archivo}')
    print(f'  {info["slides"]} slides, lienzo {info["lienzo"]}')
    for k, v in sorted(info.get('detalle', {}).items()):
        print(f'  {k}: {v}')
    if info.get('peso'):
        print(f'  imágenes: {info["peso"]}')
    if info.get('fuentes locales'):
        print(f'  tipografías guardadas en fonts/: {", ".join(info["fuentes locales"])}')
    if info.get('fuentes sin bajar'):
        print(f'  tipografías que no pude bajar (se ven con otra parecida): {", ".join(info["fuentes sin bajar"])}')
    print(f'Revisala con: diapo revisar {archivo}')
    print(f'Abrila con:   diapo ver {archivo}')


