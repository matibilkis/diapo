def huella(p: Path) -> str:
    return hashlib.sha1(p.read_bytes()).hexdigest()[:16] if p.exists() else ''


class Servidor(SimpleHTTPRequestHandler):
    raiz: Path = Path('.')
    modelo: str | None = None
    candado = threading.Lock()
    candado_chats = threading.Lock()
    chats: dict = {}

    def log_message(self, fmt, *args):
        pass

    def propio(self) -> bool:
        """Solo atiende pedidos de esta misma página: corta el acceso desde otro sitio abierto en el navegador."""
        puerto = self.server.server_address[1]
        propios = {f'127.0.0.1:{puerto}', f'localhost:{puerto}', f'[::1]:{puerto}'}
        if (self.headers.get('Host') or '') not in propios:
            return False
        origen = self.headers.get('Origin')
        return not origen or origen.removeprefix('http://') in propios

    def chat(self, p: Path) -> Chat:
        with Servidor.candado_chats:
            c = Servidor.chats.get(p)
            if c is None:
                c = Servidor.chats[p] = Chat(p, Servidor.modelo)
            return c

    def end_headers(self):
        self.send_header('Cache-Control', 'no-store')
        super().end_headers()

    def archivo(self, q) -> Path | None:
        nombre = (q.get('archivo') or [''])[0]
        p = (self.raiz / nombre).resolve()
        if self.raiz not in p.parents or p.suffix.lower() not in ('.html', '.htm'):
            return None
        return p

    def json(self, code: int, obj: dict) -> None:
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if not self.propio():
            return self.json(403, {'error': 'origen'})
        u = urlparse(self.path)
        if u.path == '/__diapo/estado':
            p = self.archivo(parse_qs(u.query))
            if not p or not p.exists():
                return self.json(404, {'error': 'archivo'})
            c = self.chat(p)
            return self.json(200, {'hash': huella(p), 'version': VERSION, 'chat': bool(shutil.which('claude')),
                                   'chat_ocupado': c.ocupado, 'modelo': c.modelo_real or Servidor.modelo or '',
                                   'historial': c.historial})
        if u.path == '/__diapo/eventos':
            p = self.archivo(parse_qs(u.query))
            if not p:
                return self.json(404, {'error': 'archivo'})
            self.send_response(200)
            self.send_header('Content-Type', 'text/event-stream')
            self.send_header('Connection', 'keep-alive')
            self.end_headers()
            cola: queue.Queue = queue.Queue()
            chat = self.chat(p)
            chat.oyentes.append(cola)
            ultimo, firma, ping = huella(p), None, time.time()
            try:
                while True:
                    try:
                        ev = cola.get(timeout=0.5)
                        self.wfile.write(f'event: chat\ndata: {json.dumps(ev, ensure_ascii=False)}\n\n'.encode())
                        self.wfile.flush()
                    except queue.Empty:
                        pass
                    st = p.stat() if p.exists() else None
                    f = (st.st_mtime_ns, st.st_size) if st else None
                    if f != firma:
                        firma = f
                        h = huella(p)
                        if h and h != ultimo:
                            ultimo = h
                            self.wfile.write(f'event: cambio\ndata: {json.dumps({"hash": h})}\n\n'.encode())
                            self.wfile.flush()
                    if time.time() - ping > 15:
                        ping = time.time()
                        self.wfile.write(b': sigo\n\n')
                        self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError, OSError):
                return
            finally:
                if cola in chat.oyentes:
                    chat.oyentes.remove(cola)
        return super().do_GET()

    def cuerpo(self) -> bytes:
        return self.rfile.read(int(self.headers.get('Content-Length') or 0))

    def do_POST(self):
        if not self.propio():
            return self.json(403, {'error': 'origen'})
        u = urlparse(self.path)
        if not u.path.startswith('/__diapo/'):
            return self.json(404, {'error': 'ruta'})
        q = parse_qs(u.query)
        p = self.archivo(q)
        if not p:
            return self.json(403, {'error': 'archivo'})
        if u.path == '/__diapo/guardar':
            cuerpo = self.cuerpo()
            base = (q.get('base') or [''])[0]
            forzar = (q.get('forzar') or ['0'])[0] == '1'
            with self.candado:
                actual = huella(p)
                if base and actual and base != actual and not forzar:
                    return self.json(409, {'hash': actual})
                respaldar(p)
                tmp = p.with_name(f'.{p.name}.tmp')
                tmp.write_bytes(cuerpo)
                os.replace(tmp, p)
                nuevo = huella(p)
            print(f'  {datetime.now():%H:%M:%S} guardado {p.name}')
            return self.json(200, {'hash': nuevo})
        if u.path == '/__diapo/chat':
            try:
                d = json.loads(self.cuerpo() or b'{}')
            except ValueError:
                return self.json(400, {'error': 'no entendí el pedido'})
            texto = str(d.get('texto') or '').strip()
            if not texto:
                return self.json(400, {'error': 'el mensaje está vacío'})
            return self.json(*self.chat(p).enviar(texto, d.get('slide'), d.get('elemento'), d.get('ctx') or ''))
        if u.path == '/__diapo/chat/parar':
            self.cuerpo()
            self.chat(p).parar()
            return self.json(200, {'ok': True})
        if u.path == '/__diapo/chat/nueva':
            self.cuerpo()
            self.chat(p).nueva()
            return self.json(200, {'ok': True})
        return self.json(404, {'error': 'ruta'})


def cmd_ver(a) -> None:
    deck = resolver_deck(a.archivo)
    Servidor.raiz = deck.parent.resolve()
    Servidor.modelo = getattr(a, 'modelo', None)
    handler = lambda *args, **kw: Servidor(*args, directory=str(Servidor.raiz), **kw)
    srv = None
    for puerto in range(a.puerto, a.puerto + 30):
        try:
            srv = ThreadingHTTPServer(('127.0.0.1', puerto), handler)
            break
        except OSError:
            continue
    if srv is None:
        die('no encontré un puerto libre.')
    srv.daemon_threads = True
    url = f'http://127.0.0.1:{srv.server_address[1]}/{quote(deck.name)}'
    texto = deck.read_text(encoding='utf-8', errors='replace')
    print(f'diapo sirviendo {deck}')
    print(f'  {url}')
    if not es_diapo(texto):
        print('  (este archivo tiene un motor viejo: se ve igual, pero guarda con el diálogo del navegador)')
    print('  Ctrl+S en la página guarda en el archivo. Si Claude lo cambia, la página se actualiza sola.')
    if shutil.which('claude'):
        print(f'  Chat con Claude: tecla C o botón «Claude». Usa Claude Code con tu cuenta{", modelo " + a.modelo if getattr(a, "modelo", None) else ""}.')
    else:
        print('  (sin chat: no encuentro el comando claude)')
    print('  Ctrl+C acá para cerrar.')
    if not a.no_abrir:
        threading.Timer(0.4, lambda: webbrowser.open(url + ('?editar' if a.editar else ''))).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print('\ncerrado.')
    finally:
        for c in list(Servidor.chats.values()):
            c.parar(avisar=False)


