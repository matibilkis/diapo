def tema_dir(nombre: str) -> Path:
    d = TEMAS / nombre
    if not (d / 'tema.json').exists():
        disponibles = ', '.join(sorted(x.name for x in TEMAS.iterdir() if (x / 'tema.json').exists()))
        die(f'no conozco el tema «{nombre}». Temas: {disponibles}')
    return d


def armar(titulo: str, secciones: str, *, archivo: str, ancho: int = 1280, alto: int = 720,
          fuentes_css: str, tema_css: str, estilos_css: str, google: str | None) -> str:
    link = ''
    if google:
        link = ('<link rel="preconnect" href="https://fonts.googleapis.com">\n'
                '<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>\n'
                f'<link rel="stylesheet" href="{esc(google)}">')
    partes = [
        '<!DOCTYPE html>',
        '<!--',
        f'  {titulo} · hecha con diapo ({RAIZ})',
        f'  Para abrirla y editarla: diapo ver {archivo}   (E edita · Ctrl+S guarda · ? ayuda)',
        f'  Formato: cada slide es un section.slide dentro de #deck; lo movible lleva la clase el y left/top/width en px sobre {ancho}×{alto};',
        '  notas en aside.notas; pedidos a Claude en data-pedido; colores en #tema; estilos de texto en #estilos.',
        '-->',
        '<html lang="es">',
        '<head>',
        '<meta charset="utf-8">',
        '<meta name="viewport" content="width=device-width, initial-scale=1">',
        f'<meta name="generator" content="diapo {VERSION}">',
        f'<title>{esc(titulo)}</title>',
        f'<style id="fuentes">\n{fuentes_css.strip()}\n</style>',
        link,
        f'<style id="tema">\n{tema_css.strip()}\n</style>',
        f'<style id="estilos">\n{estilos_css.strip()}\n</style>',
        f'<style id="motor-css">\n{MOTOR_CSS.read_text(encoding="utf-8").strip()}\n</style>',
        '</head>',
        '<body>',
        f'<div id="deck" data-ancho="{ancho}" data-alto="{alto}">',
        secciones.strip(),
        '</div>',
        '',
        f'<script id="motor">\n{MOTOR_JS.read_text(encoding="utf-8").strip()}\n</script>',
        '</body>',
        '</html>',
        '',
    ]
    return '\n'.join(partes)


def copiar_fuentes(tdir: Path, carpeta: Path) -> None:
    src = tdir / 'fonts'
    if not src.is_dir():
        return
    dst = carpeta / 'fonts'
    dst.mkdir(exist_ok=True)
    for f in src.glob('*.woff2'):
        if not (dst / f.name).exists():
            shutil.copy2(f, dst / f.name)
    lic = src / 'licencias'
    if lic.is_dir():
        (dst / 'licencias').mkdir(exist_ok=True)
        for f in lic.glob('*.txt'):
            if not (dst / 'licencias' / f.name).exists():
                shutil.copy2(f, dst / 'licencias' / f.name)


def cmd_nuevo(a) -> None:
    destino = Path(a.carpeta).expanduser()
    archivo = destino if destino.suffix.lower() in ('.html', '.htm') else destino / f'{destino.name}.html'
    archivo = archivo.resolve()
    if archivo.exists():
        die(f'ya existe {archivo}; abrila con: diapo ver {archivo}')
    tdir = tema_dir(a.tema)
    meta = json.loads((tdir / 'tema.json').read_text(encoding='utf-8'))
    carpeta = archivo.parent
    carpeta.mkdir(parents=True, exist_ok=True)
    (carpeta / 'img').mkdir(exist_ok=True)
    copiar_fuentes(tdir, carpeta)
    titulo = a.titulo or archivo.stem.replace('-', ' ').replace('_', ' ').strip().capitalize()
    c = config()
    secciones = (tdir / 'inicio.html').read_text(encoding='utf-8')
    for clave, valor in (('titulo', titulo), ('nombre', c.get('nombre') or 'Tu nombre'), ('mail', c.get('mail') or 'tu@correo')):
        secciones = secciones.replace('{{' + clave + '}}', esc(valor))
    escribir(archivo, armar(titulo, secciones, archivo=archivo.name,
                            fuentes_css=(tdir / 'fuentes.css').read_text(encoding='utf-8'),
                            tema_css=(tdir / 'tema.css').read_text(encoding='utf-8'),
                            estilos_css=(tdir / 'estilos.css').read_text(encoding='utf-8'),
                            google=meta.get('google')))
    carpeta_oculta(carpeta)
    print(f'Lista: {archivo}')
    print(f'Tema «{a.tema}», slides de ejemplo para reemplazar.')
    print(f'Abrila con: diapo ver {archivo}')


