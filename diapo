def bajar_fuentes(familias: dict, fonts_dir: Path) -> tuple[str, list[str]]:
    reglas, faltan = [], []
    for fam in sorted(familias):
        if fam.lower() in SISTEMA:
            continue
        info = familias[fam]
        pesos = sorted(info['pesos'] or {400})
        pedidos = []
        if info['italica']:
            pedidos.append(f'{fam}:ital,wght@' + ';'.join([f'0,{w}' for w in pesos] + [f'1,{w}' for w in pesos]))
        pedidos.append(f'{fam}:wght@' + ';'.join(str(w) for w in pesos))
        pedidos.append(fam)
        css = None
        for q in pedidos:
            url = 'https://fonts.googleapis.com/css2?family=' + quote(q, safe=':,;@') + '&display=swap'
            try:
                css = urlopen(Request(url, headers={'User-Agent': UA}), timeout=15).read().decode('utf-8')
                break
            except Exception:
                css = None
        if not css:
            faltan.append(fam)
            continue
        fonts_dir.mkdir(exist_ok=True)
        for subset, body in re.findall(r'/\*\s*([\w-]+)\s*\*/\s*@font-face\s*{([^}]*)}', css):
            if subset != 'latin':
                continue
            style = re.search(r'font-style:\s*(\w+)', body).group(1)
            weight = re.search(r'font-weight:\s*([\d ]+);', body).group(1).strip()
            src = re.search(r'url\((https[^)]+)\)', body).group(1)
            nombre = f"{re.sub(r'[^A-Za-z0-9]', '', fam)}-{style}-{weight.replace(' ', '-')}.woff2"
            if not (fonts_dir / nombre).exists():
                try:
                    (fonts_dir / nombre).write_bytes(urlopen(Request(src, headers={'User-Agent': UA}), timeout=30).read())
                except Exception:
                    continue
            reglas.append(f"@font-face{{font-family:'{fam}';font-style:{style};font-weight:{weight};font-display:swap;src:url(fonts/{nombre}) format('woff2')}}")
    return '\n'.join(reglas), faltan


