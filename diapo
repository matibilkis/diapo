def local(tag: str) -> str:
    return tag.rsplit('}', 1)[-1]


def es_verdad(v) -> bool:
    return v in ('1', 'true', 'on')


def separar_peso(face: str) -> tuple[str, int | None]:
    partes = face.split()
    if len(partes) > 2 and (partes[-2] + partes[-1]).lower() in PESOS:
        return ' '.join(partes[:-2]), PESOS[(partes[-2] + partes[-1]).lower()]
    if len(partes) > 1 and partes[-1].lower().replace('-', '') in PESOS:
        return ' '.join(partes[:-1]), PESOS[partes[-1].lower().replace('-', '')]
    return face, None


