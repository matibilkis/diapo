def copiar_katex(carpeta: Path) -> None:
    """KaTeX al lado de la presentación, para las ecuaciones $…$ sin internet."""
    dest = carpeta / 'katex'
    if (dest / 'VERSION').exists() and (dest / 'VERSION').read_bytes() == (KATEX / 'VERSION').read_bytes():
        return
    shutil.copytree(KATEX, dest, dirs_exist_ok=True)


def copiar_fuentes(tdir: Path, carpeta: Path) -> None:
    src = tdir / 'fonts'
    if not src.is_dir():
        return
    dst = carpeta / 'fonts'
    dst.mkdir(exist_ok=True)
    for f in src.glob('*.woff2'):
        if not (dst / f.name).exists():
            shutil.copy2(f, dst / f.name)
    lic = src / 'licencias'
    if lic.is_dir():
        (dst / 'licencias').mkdir(exist_ok=True)
        for f in lic.glob('*.txt'):
            if not (dst / 'licencias' / f.name).exists():
                shutil.copy2(f, dst / 'licencias' / f.name)


