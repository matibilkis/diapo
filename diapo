VACIOS = {'img', 'br', 'hr', 'meta', 'link', 'input', 'col', 'source', 'wbr', 'area', 'base', 'embed', 'track'}


class LectorPedidos(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.slide = 0
        self.titulo = ''
        self.pila = []
        self.capturas = []
        self.pedidos = []
        self.en_deck = False

    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        if tag == 'div' and d.get('id') == 'deck':
            self.en_deck = True
        if not self.en_deck:
            return
        clases = (d.get('class') or '').split()
        if tag == 'section' and 'slide' in clases:
            self.slide += 1
            self.titulo = d.get('data-titulo', '')
            if d.get('data-pedido'):
                self.pedidos.append({'slide': self.slide, 'titulo': self.titulo, 'donde': 'toda la slide', 'pedido': d['data-pedido']})
        elif d.get('data-pedido') is not None:
            rec = {'slide': self.slide, 'titulo': self.titulo, 'pedido': d['data-pedido'], 'tag': tag,
                   'clases': ' '.join(c for c in clases if c != 'el'), 'estilo': d.get('style', ''), 'src': d.get('src', ''), 'texto': ''}
            self.pedidos.append(rec)
            if tag not in VACIOS:
                self.capturas.append((rec, len(self.pila)))
        if tag not in VACIOS:
            self.pila.append(tag)

    def handle_endtag(self, tag):
        if not self.en_deck or tag in VACIOS:
            return
        if self.pila:
            self.pila.pop()
        self.capturas = [(r, n) for r, n in self.capturas if n < len(self.pila)]

    def handle_data(self, data):
        for rec, _ in self.capturas:
            rec['texto'] += data


def cmd_pedidos(a) -> None:
    deck = resolver_deck(a.archivo)
    lp = LectorPedidos()
    lp.feed(deck.read_text(encoding='utf-8', errors='replace'))
    for p in lp.pedidos:
        if 'texto' in p:
            p['texto'] = re.sub(r'\s+', ' ', p['texto']).strip()
            pos = re.search(r'left:\s*(-?[\d.]+)px;\s*top:\s*(-?[\d.]+)px', p.get('estilo', ''))
            p['donde'] = (f'imagen {p["src"]}' if p['tag'] == 'img' else f'«{p["texto"][:80]}»' if p['texto'] else f'<{p["tag"]} class="{p["clases"]}">') + (f' en x {pos.group(1)}, y {pos.group(2)}' if pos else '')
    if a.json:
        print(json.dumps([{k: v for k, v in p.items() if k in ('slide', 'titulo', 'donde', 'pedido')} for p in lp.pedidos], ensure_ascii=False, indent=1))
        return
    if not lp.pedidos:
        print('No hay pedidos.')
        return
    for p in lp.pedidos:
        print(f'slide {p["slide"]} «{p["titulo"]}» · {p["donde"]}')
        print(f'  pedido: {p["pedido"]}')
    print(f'{len(lp.pedidos)} pedido(s). Al resolver uno, borrá su atributo data-pedido.')


def cmd_actualizar(a) -> None:
    deck = resolver_deck(a.archivo)
    texto = deck.read_text(encoding='utf-8')
    if not es_diapo(texto):
        die('este archivo no tiene el formato de diapo (le faltan los bloques #motor-css y #motor); no lo toco.')
    nuevo_css = MOTOR_CSS.read_text(encoding='utf-8').strip()
    nuevo_js = MOTOR_JS.read_text(encoding='utf-8').strip()
    t2 = re.sub(r'(<style id="motor-css">)(.*?)(</style>)', lambda m: f'{m.group(1)}\n{nuevo_css}\n{m.group(3)}', texto, count=1, flags=re.S)
    t2 = re.sub(r'(<script id="motor">)(.*?)(</script>)', lambda m: f'{m.group(1)}\n{nuevo_js}\n{m.group(3)}', t2, count=1, flags=re.S)
    t2 = re.sub(r'<meta name="generator" content="diapo [^"]*">', f'<meta name="generator" content="diapo {VERSION}">', t2, count=1)
    copiar_katex(deck.parent)
    if t2 == texto:
        print(f'{deck.name} ya tenía el motor al día.')
        return
    respaldar(deck, cada=0)
    escribir(deck, t2)
    print(f'Motor actualizado en {deck.name} (respaldo en .diapo/respaldos/).')


def cmd_previa(a) -> None:
    deck = resolver_deck(a.archivo)
    texto = deck.read_text(encoding='utf-8')
    t = re.sub(r'^\s*<!DOCTYPE html>\s*', '', texto, flags=re.I)
    for pat in (r'<html[^>]*>\s*', r'</html>\s*', r'<head>\s*', r'</head>\s*', r'<body>\s*', r'</body>\s*',
                r'<meta charset="[^"]*">\s*', r'<meta name="viewport"[^>]*>\s*'):
        t = re.sub(pat, '', t, count=1, flags=re.I)
    if a.titulo:
        t = re.sub(r'<title>[^<]*</title>', f'<title>{esc(a.titulo)}</title>', t, count=1)
    t = t.replace('<script id="motor">', '<script>window.DIAPO_VISTA_PREVIA = true;</script>\n<script id="motor">', 1)
    dest = carpeta_oculta(deck.parent, 'previa') / deck.name
    dest.write_text(t, encoding='utf-8')
    refs = sorted(set(re.findall(r'''(?:src|href)="((?:img|fonts)/[^"#?]+)"''', texto)) | set(re.findall(r'url\(((?:img|fonts)/[^)]+)\)', texto)))
    if '$' in texto and (deck.parent / 'katex').is_dir():
        refs += sorted(str(f.relative_to(deck.parent)) for f in (deck.parent / 'katex').rglob('*') if f.is_file() and f.suffix in ('.js', '.css', '.woff2'))
    refs = [r for r in refs if (deck.parent / r).exists()]
    print(json.dumps({'archivo': str(dest), 'raiz': str(deck.parent), 'archivos': refs}, ensure_ascii=False, indent=1))


