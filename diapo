HUECO_RE = re.compile(r'<div class="el hueco([^"]*)" style="([^"]*)"([^>]*)>(.*?)</div>', re.S)


def ext_de(data: bytes, nombre: str) -> str:
    ext = Path(nombre).suffix.lower()
    if ext in ('.png', '.jpg', '.jpeg', '.gif', '.webp', '.svg', '.bmp', '.tif', '.tiff'):
        return ext
    cabeza = data[:512]
    if cabeza.startswith(b'\x89PNG'):
        return '.png'
    if cabeza.startswith(b'\xff\xd8'):
        return '.jpg'
    if cabeza.startswith(b'GIF8'):
        return '.gif'
    if cabeza[:4] == b'RIFF' and cabeza[8:12] == b'WEBP':
        return '.webp'
    if b'<svg' in cabeza:
        return '.svg'
    return ext or '.png'


def tam_svg(data: bytes) -> tuple[int, int]:
    t = data[:4000].decode('utf-8', 'replace')
    m = re.search(r'viewBox="\s*[-\d.]+[\s,]+[-\d.]+[\s,]+([\d.]+)[\s,]+([\d.]+)', t)
    if m:
        return round(float(m.group(1))), round(float(m.group(2)))
    w, h = re.search(r'<svg[^>]*\swidth="([\d.]+)', t), re.search(r'<svg[^>]*\sheight="([\d.]+)', t)
    return (round(float(w.group(1))), round(float(h.group(1)))) if w and h else (100, 100)


def rango_slide(texto: str, n: int) -> tuple[int, int]:
    e = Estructura()
    e.feed(texto)
    if not 1 <= n <= len(e.slides):
        die(f'no hay slide {n}; la presentación tiene {len(e.slides)}.')
    s = e.slides[n - 1]
    inicios = [0]
    for linea in texto.split('\n'):
        inicios.append(inicios[-1] + len(linea) + 1)
    return inicios[s['ini'] - 1], inicios[min(s['fin'], len(inicios) - 1)]


def poner_en_hueco(texto: str, cual: str, src: str, tam: tuple[int, int], alt: str = '') -> tuple[str, str]:
    """Reemplaza el recuadro K de la slide N («N» o «N:K») por la imagen, ajustada a su caja."""
    n, _, k = cual.partition(':')
    try:
        n, k = int(n), int(k or 1)
    except ValueError:
        die(f'--hueco va como N o N:K (slide y número de recuadro), no «{cual}».')
    ini, fin = rango_slide(texto, n)
    huecos = list(HUECO_RE.finditer(texto, ini, fin))
    if not huecos:
        die(f'la slide {n} no tiene recuadros para completar.')
    if not 1 <= k <= len(huecos):
        die(f'la slide {n} tiene {len(huecos)} recuadros; pediste el {k}.')
    m = huecos[k - 1]
    extra, estilo, descripcion = m.group(1).split(), m.group(2), texto_plano(m.group(4))
    medida = lambda p: float(x.group(1)) if (x := re.search(rf'(?<![\w-]){p}\s*:\s*(-?[\d.]+)px', estilo)) else None
    L, T, w, h = medida('left'), medida('top'), medida('width'), medida('height')
    if None in (L, T, w):
        die(f'el recuadro {k} de la slide {n} no tiene posición en px.')
    h = h or w
    alt = alt or descripcion
    if 'circulo' in extra or 'cubrir' in extra:
        clases = ' '.join(['el'] + [c for c in extra if c in ('circulo', 'cubrir', 'sangrado')])
        st = f'left:{round(L)}px;top:{round(T)}px;width:{round(w)}px;height:{round(h)}px'
    else:
        iw, ih = tam
        f = min(w / iw, h / ih)
        ww, hh = iw * f, ih * f
        clases = ' '.join(['el'] + [c for c in extra if c == 'sangrado'])
        st = f'left:{round(L + (w - ww) / 2)}px;top:{round(T + (h - hh) / 2)}px;width:{round(ww)}px'
    img = f'<img class="{clases}" src="{esc(src)}" alt="{esc(alt)}" style="{st}">'
    return texto[:m.start()] + img + texto[m.end():], descripcion


def cmd_imagen(a) -> None:
    deck = resolver_deck(a.archivo)
    texto = deck.read_text(encoding='utf-8')
    W, H = medidas(texto)
    mq = Maquetador('', W, H, deck.parent, Path.cwd())
    src, tam = mq.traer(a.fuente)
    if not src:
        die((mq.avisos[0] if mq.avisos else f'no pude traer {a.fuente}').replace('; quedó un recuadro', ''))
    if not a.hueco:
        print(f'Guardada: {src} ({tam[0]}×{tam[1]} px). Para usarla: <img class="el" src="{src}" alt="" style="left:…px;top:…px;width:…px">')
        return
    nuevo, desc = poner_en_hueco(texto, a.hueco, src, tam, a.alt or '')
    respaldar(deck, cada=0)
    escribir(deck, nuevo)
    print(f'Puse {src} en el recuadro «{desc[:60]}» (slide {a.hueco.split(":")[0]}).')
    if a.fuente.startswith(('http://', 'https://')):
        print('  Dejá el origen y la licencia de la imagen en las notas de esa slide.')


def cmd_qr(a) -> None:
    deck = resolver_deck(a.archivo)
    if not shutil.which('uv'):
        die('para hacer QR hace falta uv (https://docs.astral.sh/uv/).')
    codigo = ('import segno, sys\n'
              'q = segno.make(sys.argv[1], error="m")\n'
              'q.save(sys.stdout.buffer, kind="svg", border=2, scale=10, dark="#000", light="#fff", xmldecl=False)\n')
    r = subprocess.run(['uv', 'run', '--quiet', '--no-project', '--with', 'segno', 'python', '-c', codigo, a.url],
                       capture_output=True, timeout=120)
    if r.returncode or b'<svg' not in r.stdout:
        die('no pude generar el QR: ' + r.stderr.decode('utf-8', 'replace').strip()[-300:])
    slug = re.sub(r'[^\w]+', '-', re.sub(r'^https?://(www\.)?', '', a.url)).strip('-')[:40] or 'link'
    src = guardar_imagen(deck.parent, f'qr-{slug}', '.svg', r.stdout)
    if not a.hueco:
        print(f'Guardado: {src}. Para usarlo: <img class="el" src="{src}" alt="QR" style="left:…px;top:…px;width:…px">')
        return
    texto = deck.read_text(encoding='utf-8')
    nuevo, desc = poner_en_hueco(texto, a.hueco, src, (1, 1), f'QR: {a.url}')
    respaldar(deck, cada=0)
    escribir(deck, nuevo)
    print(f'Puse el QR de {a.url} en el recuadro «{desc[:60]}» (slide {a.hueco.split(":")[0]}).')


